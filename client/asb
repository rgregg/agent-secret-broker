def die(msg, code=EXIT_USAGE):
    print(f"asb: {msg}", file=sys.stderr)
    sys.exit(code)


def config():
    url, key = os.environ.get("SECRET_BROKER_URL"), os.environ.get("SECRET_BROKER_KEY")
    if not (url and key):
        try:
            with open(os.path.expanduser("~/.config/secret-broker/client.json")) as f:
                c = json.load(f)
            url, key = c["url"], c["key"]
        except (OSError, KeyError, json.JSONDecodeError):
            die("no broker config (set SECRET_BROKER_URL/KEY or ~/.config/secret-broker/client.json)")
    return url.rstrip("/"), key


def call(base, key, path, body=None, timeout=40):
    req = urllib.request.Request(
        base + path, headers={"X-Client-Key": key, "Content-Type": "application/json"},
        data=json.dumps(body).encode() if body is not None else None)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, json.load(r)
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.load(e)
        except json.JSONDecodeError:
            return e.code, {"error": e.reason}
    except OSError as e:
        die(f"cannot reach broker: {e}", EXIT_BROKER)


def status_exit(status):
    return {"denied": EXIT_DENIED, "expired": EXIT_EXPIRED}.get(status, EXIT_BROKER)


def check_name(name, what="NAME"):
    if name.startswith("-"):
        die(f"{what} {name!r} looks like a flag, not a credential name "
            "(see `asb list`; `asb help` for usage)")
    return name


def obtain(payload):
    base, key = config()
    payload["source"] = f"{os.environ.get('USER', '?')}@{socket.gethostname()}"
    code, r = call(base, key, "/v1/requests", payload)
    if code != 202:
        die(r.get("error", f"broker returned {code}"), EXIT_BROKER)
    if r["status"] in ("denied", "expired", "failed"):
        die(r.get("error") or r["status"], status_exit(r["status"]))
    print("asb: waiting for approval on your phone...", file=sys.stderr)
    deadline = time.time() + r["expires_in"] + 15
    while time.time() < deadline:
        code, r2 = call(base, key, f"/v1/requests/{r['id']}?wait=25")
        if r2.get("status") == "approved":
            return r2
        if r2.get("status") in ("denied", "expired", "failed", "released"):
            die(f"request {r2['status']}" + (f": {r2['error']}" if r2.get("error") else ""),
                status_exit(r2["status"]))
    die("timed out waiting for approval", EXIT_EXPIRED)


MAX_BODY = 5_000_000


def read_body(arg):
    """-d BODY | -d @file | -d @- (stdin). Returns payload fields for the broker.

    UTF-8 content is sent as text so {{VAR}} placeholders are substituted;
    anything else is sent as base64 and passed through untouched.
    """
    if not arg.startswith("@"):
        return {"body": arg}
    try:
        raw = sys.stdin.buffer.read() if arg == "@-" else open(arg[1:], "rb").read()
    except OSError as e:
        die(f"cannot read body: {e}")
    if len(raw) > MAX_BODY:
        die(f"body is {len(raw)} bytes; limit is {MAX_BODY}")
    try:
        return {"body": raw.decode("utf-8")}
    except UnicodeDecodeError:
        return {"body_b64": base64.b64encode(raw).decode()}


def read_value():
    """The credential value: stdin (pipe) or a hidden prompt on a terminal. It is
    never accepted as an argument, so it cannot end up in shell history or ps."""
    if sys.stdin.isatty():
        import getpass
        v = getpass.getpass("value (hidden): ")
    else:
        v = sys.stdin.read()
    v = v.rstrip("\r\n")
    if not v:
        die("no value on stdin")
    return v


def parse_flags(argv, allowed):
    out, i = {}, 0
    while i < len(argv):
        k = argv[i]
        if k not in allowed or i + 1 >= len(argv):
            die(f"unexpected argument {k!r}")
        out[allowed[k]] = argv[i + 1]
        i += 2
    return out


# -- ssh-agent protocol (draft-miller-ssh-agent) ------------------------------
AGENT_FAILURE, AGENTC_REQUEST_IDENTITIES, AGENT_IDENTITIES_ANSWER = 5, 11, 12
AGENTC_SIGN_REQUEST, AGENT_SIGN_RESPONSE = 13, 14
AGENT_SUCCESS, AGENTC_EXTENSION = 6, 27
BIND_EXT = b"session-bind@openssh.com"
MAX_BINDS = 16              # per agent connection


def _strings(b, n):
    """n length-prefixed strings from the front of b, then whatever is left."""
    out = []
    for _ in range(n):
        ln = int.from_bytes(b[:4], "big")
        if len(b) < 4 + ln:
            raise ValueError("short string")
        out.append(b[4:4 + ln])
        b = b[4 + ln:]
    return out, b


# -- claimed destination: what the wrapped command line says it connects to ----
# Unverified by construction (ssh_config can rename hosts, a script can do
# anything); the broker shows it as "claimed by the client".
_SSH_VAL = set("BbcDEeFIiJLlmOopQRSWw")             # ssh options that take an argument
_SCP_VAL = set("cDFiJloPS")
_SFTP_VAL = set("BbcDFiJloPRSs")
_HOST_RE = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9._-]*$|^[0-9A-Fa-f:.]*:[0-9A-Fa-f:.]*$")
_USER_RE = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9._-]*$")


def _walk(args, val_opts):
    """Split ssh-style args into ([(opt char, value)], operands). Stops at the
    first operand when val_opts is for ssh (the rest is the remote command)."""
    opts, ops, i = [], [], 0
    while i < len(args):
        a = args[i]
        i += 1
        if a == "--":
            ops += args[i:]
            break
        if a.startswith("-") and len(a) > 1:
            j = 1
            while j < len(a):
                c = a[j]
                if c in val_opts:
                    v = a[j + 1:] or (args[i] if i < len(args) else "")
                    if not a[j + 1:]:
                        i += 1
                    opts.append((c, v))
                    break
                j += 1
            continue
        ops.append(a)
    return opts, ops


def _o_pairs(opts):
    """-o Key=Value / -o 'Key Value' -> {lower key: value} (first wins, like ssh)."""
    out = {}
    for c, v in opts:
        if c == "o":
            k, _, val = v.replace("=", " ", 1).partition(" ")
            out.setdefault(k.strip().lower(), val.strip())
    return out


def _fmt(user, host, port, jump=None):
    if not host or not _HOST_RE.match(host) or (user and not _USER_RE.match(user)):
        return None
    try:
        port = int(port)
    except (TypeError, ValueError):
        return None
    if not 0 < port < 65536:
        return None
    h = f"[{host}]" if ":" in host else host
    out = (f"{user}@" if user else "") + f"{h}:{port}"
    if jump:
        out += f" (via {jump})"
    return out[:200]


def _split_target(t):
    """[user@]host | ssh://[user@]host[:port][/..] -> (user, host, port|None)."""
    user = port = None
    url = t.startswith(("ssh://", "scp://", "sftp://"))
    if url:
        t = t.split("://", 1)[1].split("/", 1)[0]
    if "@" in t:
        user, _, t = t.rpartition("@")
    if t.startswith("["):
        host, _, rest = t[1:].partition("]")
        if rest.startswith(":") and rest[1:]:
            port = rest[1:]
    elif url and t.count(":") == 1:
        host, _, port = t.partition(":")
    else:
        host = t
    return user or None, host, port


def _jump_note(jump):
    hops = [h for h in (jump or "").split(",") if h]
    if not hops or not all(re.fullmatch(r"[A-Za-z0-9@._:\[\]%-]+", h) for h in hops):
        return None
    return hops[0] + (f"+{len(hops) - 1}" if len(hops) > 1 else "")


def _build(user, host, port, opts, jump_opt=None):
    o = _o_pairs(opts)
    host = o.get("hostname") or host
    user = user or o.get("user")
    port = port or o.get("port") or "22"
    return _fmt(user, host, port, _jump_note(jump_opt or o.get("proxyjump")))


def _first(opts):
    d = {}
    for c, v in opts:
        d.setdefault(c, v)
    return d


def _ssh_claim(args):
    """ssh [options] [user@]host [command]: the first operand is the destination."""
    opts, i = [], 0
    while i < len(args):
        a = args[i]
        i += 1
        if a == "--":
            break
        if not (a.startswith("-") and len(a) > 1):
            i -= 1
            break
        for j in range(1, len(a)):
            if a[j] in _SSH_VAL:
                if a[j + 1:]:
                    opts.append((a[j], a[j + 1:]))
                elif i < len(args):
                    opts.append((a[j], args[i]))
                    i += 1
                break
    if i >= len(args):
        return None
    user, host, port = _split_target(args[i])
    d = _first(opts)
    return _build(user or d.get("l"), host, port or d.get("p"), opts, d.get("J"))


def _rsync_args(args):
    """-> (remote shell command string, operands) for an rsync command line."""
    rsh, ops, i = "ssh", [], 0
    while i < len(args):
        a = args[i]
        i += 1
        if a.startswith("--rsh="):
            rsh = a[6:]
        elif a == "--rsh" and i < len(args):
            rsh, i = args[i], i + 1
        elif a.startswith("-") and not a.startswith("--") and a.endswith("e") and i < len(args):
            rsh, i = args[i], i + 1                 # -e CMD, or a cluster ending in e (-ae CMD)
        elif not a.startswith("-"):
            ops.append(a)
    return rsh, ops


def _remote_operand(a):
    """`[user@]host:path` / `scp://...` operand of scp, sftp or rsync -> (user, host, port) or None."""
    if a.startswith(("scp://", "sftp://", "ssh://")):
        t = _split_target(a)
        return t if t[1] else None
    if a.startswith(("rsync://", "-", "/", ".", "~")):
        return None
    head = a.split("/", 1)[0]
    if "@" in head:
        user, _, rest = a.partition("@")
    else:
        user, rest = None, a
    if rest.startswith("["):
        host, _, after = rest[1:].partition("]")
        return (user, host, None) if after.startswith(":") else None
    if "::" in rest.split("/", 1)[0]:
        return None                         # host::module is an rsync daemon, not ssh
    host, sep, _path = rest.partition(":")
    return (user, host, None) if sep and "/" not in host else None


def claimed_destination(argv):
    """The `user@host:port` the command line says it will connect to, or None
    when that cannot be told confidently. Never runs anything."""
    try:
        if not argv:
            return None
        prog, args = os.path.basename(argv[0]), list(argv[1:])
        if prog == "ssh":
            return _ssh_claim(args)
        if prog in ("scp", "sftp", "rsync"):
            val = _SCP_VAL if prog == "scp" else _SFTP_VAL if prog == "sftp" else set()
            if prog == "rsync":
                rsh, ops = _rsync_args(args)
                words = shlex.split(rsh)
                if not words or os.path.basename(words[0]) != "ssh":
                    return None
                sopts = _walk(words[1:], _SSH_VAL)[0]
            else:
                opts, ops = _walk(args, val)
                sopts = [("p" if c == "P" else c, v) for c, v in opts]
            if prog == "sftp":
                ops = ops[:1]
                targets = {_remote_operand(ops[0]) or _split_target(ops[0])} if ops else set()
            else:
                targets = {t for t in map(_remote_operand, ops) if t}
            if len(targets) != 1:
                return None             # nothing remote, or several different hosts
            (user, host, port), = targets
            d = _first(sopts)
            return _build(user or d.get("l"), host, port or d.get("p"), sopts, d.get("J"))
        if prog == "git":
            cands = set()
            for a in args:
                if a.startswith("ssh://"):
                    cands.add(_split_target(a))
                elif "@" in a.split(":", 1)[0] and not a.startswith(("-", "/", ".")):
                    t = _remote_operand(a)      # git@host:org/repo (user@ required: refspecs have colons)
                    if t:
                        cands.add(t)
            if len(cands) != 1:
                return None
            (user, host, port), = cands
            return _fmt(user, host, port or "22")
    except (ValueError, IndexError):
        return None
    return None


def _s(b):
    return len(b).to_bytes(4, "big") + b


def _read_msg(conn):
    def exact(n):
        buf = b""
        while len(buf) < n:
            chunk = conn.recv(n - len(buf))
            if not chunk:
                return None
            buf += chunk
        return buf
    head = exact(4)
    if head is None:
        return None
    n = int.from_bytes(head, "big")
    return exact(n) if 0 < n <= 1_000_000 else None


def _ssh_identities():
    base, key = config()
    code, r = call(base, key, "/v1/secrets")
    if code != 200:
        return []
    out = []
    for s in r["secrets"]:
        if s.get("ssh_public_key"):
            try:
                out.append((s["name"], base64.b64decode(s["ssh_public_key"].split()[1])))
            except (IndexError, ValueError):
                pass
    return out


def agent_reply(msg, conn=None):
    """Answer one ssh-agent request. Anything unsupported is a plain failure.

    `conn` is the per-connection state of a served agent ({"binds": [...],
    "claim": str|None}); without it session binding cannot be remembered, so
    that extension is refused like any other."""
    fail = bytes([AGENT_FAILURE])
    try:
        kind, body = msg[0], msg[1:]
        if kind == AGENTC_EXTENSION:
            (name,), rest = _strings(body, 1)
            if name != BIND_EXT or conn is None:
                return fail                 # OpenSSH carries on without the extension
            if len(conn["binds"]) >= MAX_BINDS:
                conn["overflow"] = True     # the broker then treats the whole chain as invalid
                return fail
            (hostkey, sid, sig), rest = _strings(rest, 3)
            if len(rest) != 1 or rest[0] > 1:
                return fail
            # The broker verifies the signature; the agent only remembers the bind.
            conn["binds"].append({"hostkey_b64": base64.b64encode(hostkey).decode(),
                                  "session_id_b64": base64.b64encode(sid).decode(),
                                  "sig_b64": base64.b64encode(sig).decode(),
                                  "forwarding": rest[0] == 1})
            return bytes([AGENT_SUCCESS])
        if kind == AGENTC_REQUEST_IDENTITIES:
            ids = _ssh_identities()
            return (bytes([AGENT_IDENTITIES_ANSWER]) + len(ids).to_bytes(4, "big")
                    + b"".join(_s(blob) + _s(f"broker:{name}".encode()) for name, blob in ids))
        if kind == AGENTC_SIGN_REQUEST:
            n = int.from_bytes(body[:4], "big")
            blob, rest = body[4:4 + n], body[4 + n:]
            m = int.from_bytes(rest[:4], "big")
            data, flags = rest[4:4 + m], int.from_bytes(rest[4 + m:8 + m], "big")
            name = next((nm for nm, b in _ssh_identities() if b == blob), None)
            if name is None:
                return fail
            req = {"mode": "ssh_sign", "names": [name], "flags": flags,
                   "data_b64": base64.b64encode(data).decode()}
            if conn and conn["binds"]:
                req["binds"] = conn["binds"]
            if conn and conn.get("overflow"):
                req["bind_overflow"] = True
            if conn and conn.get("claim"):
                req["claimed_dest"] = conn["claim"]
            r = obtain(req)
            return bytes([AGENT_SIGN_RESPONSE]) + _s(base64.b64decode(r["ssh_signature"]))
    except SystemExit:          # obtain() reported a denial/timeout on stderr
        return fail
    except (IndexError, ValueError, KeyError):
        return fail
    return fail


def serve_agent(path, claim=None):
    import socketserver

    class Handler(socketserver.BaseRequestHandler):
        def handle(self):
            conn = {"binds": [], "claim": claim}
            while True:
                msg = _read_msg(self.request)
                if msg is None:
                    return
                self.request.sendall(_s(agent_reply(msg, conn)))

    class Server(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
        daemon_threads = True

    return Server(path, Handler)


def run_ssh_agent(cmd, socket_path=None):
    import shutil
    import signal
    import tempfile
    import threading
    if socket_path:
        # A fixed, long-lived socket (a systemd user service, say). The directory
        # must already exist and be ours alone; a stale socket from a dead agent is
        # replaced, a live one is an error.
        path = os.path.abspath(os.path.expanduser(socket_path))
        parent = os.path.dirname(path)
        st = os.stat(parent) if os.path.isdir(parent) else die(f"{parent} is not a directory")
        if st.st_uid != os.getuid() or st.st_mode & 0o022:
            die(f"{parent} must be owned by you and not writable by others")
        if os.path.lexists(path):
            import stat
            if not stat.S_ISSOCK(os.lstat(path).st_mode):
                die(f"{path} exists and is not a socket; not replacing it")
            probe = socket.socket(socket.AF_UNIX)
            try:
                probe.connect(path)
            except OSError:
                os.unlink(path)
            else:
                die(f"an agent is already listening on {path}")
            finally:
                probe.close()
        d = None
    else:
        d = tempfile.mkdtemp(prefix="asb-agent-")    # 0700: only this user can reach the socket
        path = os.path.join(d, "agent.sock")
    old_umask = os.umask(0o177)
    try:
        srv = serve_agent(path, claimed_destination(cmd) if cmd else None)
    finally:
        os.umask(old_umask)
    os.chmod(path, 0o600)

    def on_term(*_):
        raise SystemExit(0)                          # a clean stop for systemd; finally still runs
    signal.signal(signal.SIGTERM, on_term)
    try:
        if socket_path and not cmd:
            print(f"asb: ssh-agent listening on {path}", file=sys.stderr)
            srv.serve_forever()
            return 0
        if not cmd:
            print(f"SSH_AUTH_SOCK={path}; export SSH_AUTH_SOCK;")
            sys.stdout.flush()
            srv.serve_forever()
            return 0
        threading.Thread(target=srv.serve_forever, daemon=True).start()
        return subprocess.run(cmd, env={**os.environ, "SSH_AUTH_SOCK": path}).returncode
    except KeyboardInterrupt:
        return 130
    finally:
        srv.server_close()
        if d:
            shutil.rmtree(d, ignore_errors=True)
        elif os.path.lexists(path):
            os.unlink(path)


AUDIT_FLAGS = {"--request": "request", "--event": "event", "--secret": "secret", "--since": "since",
               "--until": "until", "--source": "source", "--limit": "limit", "--before": "before",
               "--after": "after"}
AUDIT_SKIP = ("seq", "ts", "event", "request")


def audit_line(ev):
    """One human line: time, event, short request id, then the event's fields."""
    parts = []
    for k, v in ev.items():
        if k in AUDIT_SKIP or v is None:
            continue
        if isinstance(v, list):
            v = ",".join(str(x) for x in v)
        elif isinstance(v, bool):
            v = "yes" if v else "no"
        parts.append(f"{k}={v}")
    return f"{ev['ts'][:19]}Z  {ev['event']:<16} {(ev.get('request') or '-')[:8]:<8}  " + " ".join(parts)


def audit_get(base, key, path):
    code, r = call(base, key, path, timeout=30)
    if code == 400:
        die(r.get("error", "bad request"), EXIT_USAGE)
    if code != 200:
        die(r.get("error", f"broker returned {code}"), EXIT_BROKER)
    return r


def run_audit(argv):
    if argv[:1] == ["verify"]:
        if argv[1:]:
            die(HELP["audit"])
        base, key = config()
        r = audit_get(base, key, "/v1/audit/verify")
        if r["ok"]:
            print(f"audit log ok: {r['events']} events, hash chain intact")
            return 0
        print(f"audit log BROKEN: chain fails at seq {r['first_bad_seq']} "
              f"({r['events']} events checked)", file=sys.stderr)
        return EXIT_NOT_FOUND
    flags, as_json, tail, i = {}, False, False, 0
    while i < len(argv):
        a = argv[i]
        if a == "--json":
            as_json = True
        elif a == "--tail":
            tail = True
        elif a in AUDIT_FLAGS and i + 1 < len(argv):
            flags[AUDIT_FLAGS[a]] = argv[i + 1]
            i += 1
        else:
            die(f"unexpected argument {a!r}\n" + HELP["audit"])
        i += 1
    if tail and ("request" in flags or "before" in flags or "after" in flags):
        die("--tail follows the whole log; combine it with --event/--secret/--source only")
    base, key = config()
    qs = lambda extra: "/v1/audit?" + urllib.parse.urlencode({**flags, **extra})  # noqa: E731
    if not tail:
        r = audit_get(base, key, qs({}))
        if as_json:
            print(json.dumps(r, indent=2))
        else:
            evs = r["events"] if flags.get("request") or "after" in flags else r["events"][::-1]
            for ev in evs:
                print(audit_line(ev))
            if r["truncated"] or r["next"] is not None:
                arrow = "--after" if "after" in flags or flags.get("request") else "--before"
                print(f"asb: more events available; continue with {arrow} {r['next']}"
                      if r["next"] is not None else "asb: older history is not indexed",
                      file=sys.stderr)
        return 0 if r["events"] else EXIT_NOT_FOUND
    flags.setdefault("limit", "20")
    last = None
    try:
        while True:
            if last is None:
                r = audit_get(base, key, qs({}))
                evs = r["events"][::-1]
            else:
                r = audit_get(base, key, qs({"after": last, "order": "asc", "limit": "500"}))
                evs = r["events"]
            for ev in evs:
                print(json.dumps(ev) if as_json else audit_line(ev), flush=True)
                last = ev["seq"]
            time.sleep(2)
    except KeyboardInterrupt:
        return 0


