SCRIPT_TEXT_BYTES = 32 * 1024        # text sent per script
SCRIPT_HEAD_ONLY = 256 * 1024        # (documented limit: beyond this only the head is ever read)
SCRIPT_HASH_MAX = 64 * 1024 * 1024   # larger files are not hashed: unreadable too_large
