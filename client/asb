def env_payload(names, cmd):
    """The env-mode request for running `cmd`, and the script entries it carries."""
    payload = {"mode": "env", "names": names, "argv": cmd}
    try:
        cwd = os.getcwd()
        if cwd.startswith("/") and len(cwd) <= 300 and not re.search(r"[\x00-\x1f\x7f]", cwd):
            payload["cwd"] = cwd        # lets the broker resolve relative script operands
    except OSError:
        pass
    try:
        scripts = find_scripts(cmd)
    except Exception:  # noqa: BLE001  (script detection is a courtesy; it never blocks a request)
        scripts = []
    if scripts:
        payload["scripts"] = scripts
    return payload, scripts


ROOT_EXEC = "/usr/local/sbin/asb-root-exec"


def run_root_exec(cmd):
    """`asb sudo -- command...`: the root helper asks the broker, and runs the command only if the
    human approves. No password anywhere; sudo's one passwordless rule names the helper. The helper
    prints its own progress and the command's output goes straight through (nothing secret to mask)."""
    helper = os.environ.get("ASB_ROOT_EXEC") or ROOT_EXEC     # sudoers allows only the installed path, so this cannot escalate
    try:
        return subprocess.run(["sudo", "-n", helper, "--"] + cmd).returncode
    except FileNotFoundError:
        die("sudo is not installed on this machine")


def run_sudo(argv):
    """`asb sudo -- command...` (root helper, no password) or `asb sudo NAME -- command...` (a stored
    sudo password credential, fed to sudo through askpass)."""
    if argv[:1] == ["--"] and len(argv) > 1:
        return run_root_exec(argv[1:])
    if len(argv) < 3 or argv[1] != "--":
        die(HELP["sudo"])
    name, cmd = check_name(argv[0]), argv[2:]
    if "," in name:
        die("asb sudo uses exactly one credential")
    # The broker is shown (and risk-rates) the command as sudo will run it; it already unwraps `sudo`.
    payload, scripts = env_payload([name], ["sudo"] + cmd)
    env = obtain(payload, "waiting for approval to run under sudo...")["env"]
    if len(env) != 1:
        die(f"credential {name!r} must have exactly one variable (the sudo password), it has {len(env)}",
            EXIT_BROKER)
    password = next(iter(env.values())).rstrip("\r\n")
    moved = changed_script(scripts)
    if moved:
        die(f"script {moved} changed after it was reviewed", EXIT_SCRIPT_CHANGED)
    tmp = tempfile.mkdtemp(prefix="asb-sudo-")      # 0700; holds only the helper, never the password
    try:
        helper = os.path.join(tmp, "askpass")
        with open(helper, "w") as f:
            f.write("#!/bin/sh\nprintf '%s\\n' \"$ASB_SUDO_PASSWORD\"\n")
        os.chmod(helper, 0o700)
        child_env = {**os.environ, "SUDO_ASKPASS": helper, "ASB_SUDO_PASSWORD": password}
        # -A: ask through the helper (no tty needed). -k: ignore a cached sudo timestamp, so every
        # use is approved here rather than riding on an earlier one.
        try:
            p = subprocess.run(["sudo", "-A", "-k", "--"] + cmd, env=child_env, stdin=subprocess.DEVNULL,
                               capture_output=True, text=True)
        except FileNotFoundError:
            die("sudo is not installed on this machine")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    sys.stdout.write(mask(p.stdout, [password]))
    sys.stderr.write(mask(p.stderr, [password]))
    return p.returncode


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if argv[0] == "guide":
        print(GUIDE)
        return 0
    if argv[0] == "agent-setup":
        return run_agent_setup(argv[1:])
    if argv[0] == "plan" and not any(a in ("-h", "--help") for a in argv[1:3]):
        return run_plan(argv[1:])
    if argv[0] == "help":
        topic = argv[1] if len(argv) > 1 else None
        if topic is None:
            print(__doc__)
        elif topic in HELP:
            print(HELP[topic])
        else:
            die(f"no help for {topic!r}; commands: {', '.join(k for k in HELP if k != 'run')}")
        return 0
    if argv[0] in HELP and argv[0] != "run":
        # Flags are never credential names or values: --help anywhere before an
        # http body/header value, or anywhere for the commands without free text.
        scan = argv[1:4] if argv[0] == "http" else argv[1:]
        if argv[0] == "sudo" and "--" in argv:
            scan = argv[1:argv.index("--")]       # the command's own --help is the command's
        if any(a in ("-h", "--help") for a in scan):
            print(HELP[argv[0]])
            return 0
    if argv[0] == "ssh-agent":
        rest, sock = argv[1:], None
        if rest[:1] == ["--socket"]:
            if len(rest) < 2:
                die(HELP["ssh-agent"])
            sock, rest = rest[1], rest[2:]
        if rest[:1] not in ([], ["--"]) or (rest[:1] == ["--"] and len(rest) < 2):
            die(HELP["ssh-agent"])
        return run_ssh_agent(rest[1:], sock)

    if argv[0] in ("store", "update"):
        if len(argv) < 2:
            die(HELP[argv[0]])
        ssh = "--ssh" in argv[2:] and argv[0] == "store"
        if ssh:
            argv = [a for a in argv if a != "--ssh"]
        name, op = check_name(argv[1]), "create" if argv[0] == "store" else "update"
        allowed = {"--field": "field", "--item": "item", "--var": "var", "--hosts": "hosts"}
        if op == "update":
            allowed = {"--var": "var"}
        f = parse_flags(argv[2:], allowed)
        payload = {"mode": "store", "names": [name], "op": op, "value": read_value()}
        if ssh:
            payload["ssh"] = True
        for k in ("field", "item", "var"):
            if f.get(k):
                payload[k] = f[k]
        if op == "create":
            if not f.get("hosts") and not ssh:
                die("store needs --hosts (the hosts this credential may be used against)\n" + HELP["store"])
            payload["allowed_hosts"] = [h for h in (f.get("hosts") or "").split(",") if h]
        r = obtain(payload)["stored"]
        print(f"stored: {r['name']} ({r['op']}) -> item {r['item']!r} field {r['field']}")
        return 0

    if argv[0] == "request-credential":
        return run_request_credential(argv[1:])

    if argv[0] == "session":
        return run_session(argv[1:])

    if argv[0] == "ws":
        return run_ws(argv[1:])

    if argv[0] == "sudo":
        return run_sudo(argv[1:])

    if argv[0] == "enroll":
        return run_enroll(argv[1:])

    if argv[0] == "fingerprint":
        if len(argv) != 2:
            die(HELP["fingerprint"])
        import hashlib
        import socket
        import ssl
        host, _, port = argv[1].partition(":")
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
        try:
            with socket.create_connection((host, int(port or 443)), timeout=10) as raw:
                with ctx.wrap_socket(raw, server_hostname=host) as tls:
                    der = tls.getpeercert(binary_form=True)
        except (OSError, ValueError) as e:
            die(f"could not read a certificate from {argv[1]}: {e}")
        print("sha256:" + hashlib.sha256(der).hexdigest())
        print("asb: put this in the item's broker metadata as "
              '"tls_fingerprint" only after checking it is the device you mean.', file=sys.stderr)
        return 0

    if argv[0] == "list":
        if argv[1:] not in ([], ["--json"]):
            die(HELP["list"])
        base, key = config()
        code, r = call(base, key, "/v1/secrets")
        if code != 200:
            die(_srv(r.get("error", f"broker returned {code}")), EXIT_BROKER)
        if argv[1:] == ["--json"]:
            print(json.dumps(r["secrets"], indent=2))
            return 0
        if not r["secrets"]:
            print("asb: no credentials are configured", file=sys.stderr)
            return EXIT_NOT_FOUND
        print("NAME\tVARS\tHOSTS   (columns; use --json for scripts)", file=sys.stderr)
        for s in r["secrets"]:
            print(f"{s['name']}\t{','.join(s['vars'])}\t{','.join(s['allowed_hosts'])}")
        return 0

    if argv[0] == "status":
        if argv[1:] not in ([], ["--json"]):
            die(HELP["status"])
        base, key = config()
        code, r = call(base, key, "/v1/status", timeout=15)
        if code != 200:
            die(_srv(r.get("error", f"broker returned {code}")), EXIT_BROKER)
        if argv[1:] == ["--json"]:
            print(json.dumps(r, indent=2))
            return 0
        c, b = r["catalog"], r["backend"]
        d, rem = divmod(int(r["uptime_s"]), 86400)
        h, rem = divmod(rem, 3600)
        up = (f"{d}d " if d else "") + f"{h}h {rem // 60}m"
        print(f"version:  {r['version']} (built {r['build_time']})")
        print(f"uptime:   {up} (since {r['started_at']})")
        print(f"catalog:  {c['count']} secrets, {c['invalid']} invalid, {c['adopted']} adopted"
              f" (loaded {c['loaded_at'] or 'never'})")
        print(f"backend:  {b['type']} {'ok' if b['ok'] else 'FAILING'}")
        print(f"notify:   {', '.join(r['notifiers']) or 'none'}")
        return 0

    if argv[0] == "audit":
        return run_audit(argv[1:])

    if argv[0] == "guidance":
        return run_guidance(argv[1:])

    if argv[0] == "which":
        if len(argv) != 2:
            die(HELP["which"])
        check_name(argv[1], "HOST")
        base, key = config()
        target = urllib.parse.quote(argv[1], safe="")
        param = "url" if "://" in argv[1] else "host"
        code, r = call(base, key, f"/v1/secrets?{param}={target}")
        if code != 200:
            die(_srv(r.get("error", f"broker returned {code}")), EXIT_BROKER)
        for s in r["secrets"]:
            print(f"{s['name']}\t{','.join(s['vars'])}")
        if not r["secrets"]:
            print(f"asb: no credential available for {r['host']}. "
                  "See `asb list`, or add one with `asb store` "
                  "(`asb guide`).", file=sys.stderr)
            return EXIT_NOT_FOUND
        return 0

    if argv[0] == "http":
        if len(argv) < 4:
            die(HELP["http"])
        check_name(argv[1])
        names, method, url, rest = argv[1].split(","), argv[2], argv[3], argv[4:]
        headers, body, session, caps, plan = {}, {}, None, [], None
        while rest:
            if rest[0] == "--session" and len(rest) > 1:
                session = rest[1]
                if not SESSION_ID_RE.match(session):
                    die("--session needs the session id printed by `asb session open`")
                rest = rest[2:]
            elif rest[0] == "--capture" and len(rest) > 1:
                caps.append(check_capture(rest[1]))
                rest = rest[2:]
            elif rest[0] == "-H" and len(rest) > 1:
                k, _, v = rest[1].partition(":")
                headers[k.strip()] = v.strip()
                rest = rest[2:]
            elif rest[0] == "-d" and len(rest) > 1:
                body, rest = read_body(rest[1]), rest[2:]
            elif rest[0] == "--plan" and len(rest) > 1:
                plan, rest = rest[1], rest[2:]
            else:
                die(f"unexpected argument {rest[0]!r}")
        if plan is None and not session and os.environ.get("ASB_PLAN"):
            plan = os.environ["ASB_PLAN"].strip()
        if plan and session:
            die("a call uses a session or a plan, not both (unset ASB_SESSION or ASB_PLAN)")
        if plan and caps:
            die("--capture needs --session; a plan call has no captured values")
        if plan:
            # a plan call: the method goes as typed in ASCII uppercase (the broker matches it exactly)
            r = run_plan_http({"mode": "http", "names": names, "method": method.upper() if method.isascii() else method,
                               "url": url, "headers": headers, **body}, plan)
        else:
            if plan is None and not session and os.environ.get("ASB_SESSION"):
                session = os.environ["ASB_SESSION"].strip()      # keeps the id out of the process list
                if not SESSION_ID_RE.match(session):
                    die("ASB_SESSION is not a session id (the one `asb session open` printed)")
            if caps and not session:
                die("--capture needs --session (or ASB_SESSION)")
            payload = {"mode": "http", "names": names, "method": method, "url": url, "headers": headers, **body}
            if session:
                if len(names) != 1:
                    die("a session uses exactly one credential")
                payload["session"], payload["capture"] = session, caps
            full = obtain(payload, "calling inside the session...")
            r = full["http"]
            if full.get("session"):
                si = full["session"]
                note = (f"asb: session: {si['calls_left']} calls left, {si['expires_in']}s left"
                        + (f"; captured {','.join(si['captured'])}" if si.get("captured") else "")
                        + (f"; NOT captured (not found) {','.join(si['missing'])}" if si.get("missing") else ""))
                print(note, file=sys.stderr)
        print(f"HTTP {r['status']}", file=sys.stderr)
        sys.stdout.write(r["body"])
        return 0 if r["status"] < 400 else EXIT_HTTP_ERROR

    if "--" not in argv:
        die(f"unknown command {argv[0]!r}.\ncommands: list, which, status, audit, http, session, ws, plan, sudo, store, update, "
            "request-credential, guidance, enroll, ssh-agent, fingerprint, help, guide; or: asb NAME -- command\n"
            "start with `asb guide`")
    i = argv.index("--")
    names, cmd = argv[0].split(",") if i == 1 else None, argv[i + 1:]
    if not names or not cmd:
        die(HELP["run"])
    for n in names:
        check_name(n)
    payload, scripts = env_payload(names, cmd)
    env = obtain(payload)["env"]
    moved = changed_script(scripts)
    if moved:
        # advisory: catches an edit between the request and the run, nothing more
        die(f"script {moved} changed after it was reviewed", EXIT_SCRIPT_CHANGED)
    p = subprocess.run(cmd, env={**os.environ, **env}, capture_output=True, text=True)
    sys.stdout.write(mask(p.stdout, env.values()))
    sys.stderr.write(mask(p.stderr, env.values()))
    return p.returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
