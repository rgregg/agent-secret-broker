PLAN_ID_RE = re.compile(r"^[0-9a-f]{32}$")
PLAN_BODY_LIMIT = 64 * 1024
PLAN_KINDS = ("ended", "exhausted", "closed", "revoked", "unknown")


def _plan_id(v):
    """A plan id from an argument or ASB_PLAN: 32 hex digits, else a usage error."""
    if not isinstance(v, str) or not PLAN_ID_RE.match(v):
        die("a plan id is 32 lowercase hex digits (printed by `asb plan submit`)")
    return v


def _plan_refusal(code, r):
    """Exit for a broker answer that is not success, in the plan vocabulary. Nothing but fixed
    words from the broker is printed, and only as printable ASCII."""
    if not isinstance(r, dict):
        r = {}
    err = _srv(r.get("error", f"broker returned {code}"))
    if code == 404 and r.get("error") == "plan not usable":
        kind = r.get("kind") if r.get("kind") in PLAN_KINDS else "unknown"
        hint = {"unknown": "it is unknown here, was never approved, or the broker restarted",
                "ended": "its deadline passed", "exhausted": "every use was spent",
                "closed": "it was closed", "revoked": "a human revoked it"}[kind]
        die(f"plan not usable (kind: {kind}): {hint}. Stop; submit a new plan, which needs the human again.",
            EXIT_PLAN_GONE)
    if code == 429 and r.get("error") == "outside plan":
        die(f"slow down: {_safe_text(r.get('reason', 'limit'))}; retry after "
            f"{int(r['retry_after_s']) if isinstance(r.get('retry_after_s'), int) else 1} s", EXIT_SLOW_DOWN)
    if code == 403 and r.get("error") == "outside plan":
        why = f", why: {_safe_text(r['why'])}" if r.get("why") else ""
        die(f"refused: this call is outside the plan (reason: {_safe_text(r.get('reason', 'no_rule'))}{why}). "
            "No prompt was sent. Make the call without --plan to ask the human.", EXIT_OUTSIDE)
    die(err, EXIT_BROKER)


def run_plan_http(payload, plan_id):
    """POST an http request that names a plan and print the response like `asb http`."""
    base, key = config()
    payload["plan"] = _plan_id(plan_id)
    payload["source"] = f"{os.environ.get('USER', '?')}@{socket.gethostname()}"
    code, r = call(base, key, "/v1/requests", payload, timeout=60)
    if code != 202:
        _plan_refusal(code, r)
    deadline = time.time() + 120
    while time.time() < deadline:
        code, r2 = call(base, key, f"/v1/requests/{r['id']}?wait=25")
        if r2.get("status") == "approved":
            return r2["http"]
        if r2.get("status") in ("denied", "expired", "failed", "released"):
            die(f"request {r2['status']}" + (f": {_srv(r2['error'])}" if r2.get("error") else ""),
                status_exit(r2["status"]))
    die("timed out waiting for the call", EXIT_EXPIRED)


def _plan_when(s):
    s = int(s or 0)
    if s >= 3600:
        return f"{s // 3600}h {(s % 3600) // 60}m"
    return f"{s // 60}m" if s >= 60 else f"{s}s"


def _plan_print(v):
    print(f"plan:    {v['id']}")
    print(f"state:   {v['status']}")
    if v.get("left_s") or v["status"] == "active":
        print(f"left:    {_plan_when(v.get('left_s'))}")
    print(f"uses:    {v['uses']['used']} / {v['uses']['max']}")
    print(f"secrets: {', '.join(v['secrets'])}")
    for i, r in enumerate(v.get("rules") or [], 1):
        print(f"  {i}. {r['secret']} {r['method']} {r['url']} body={r['body']} used {r['uses']}/{r['max_uses']}")


def run_plan(argv):
    """asb plan submit|status|list|close. The manifest is read locally and sent as given."""
    if not argv or argv[0] not in ("submit", "status", "list", "close"):
        die(HELP["plan"])
    sub, rest = argv[0], argv[1:]
    as_json = "--json" in rest
    rest = [a for a in rest if a != "--json"]
    base, key = config()
    if sub == "submit":
        wait = True
        if "--no-wait" in rest:
            wait, rest = False, [a for a in rest if a != "--no-wait"]
        rest = [a for a in rest if a != "--wait"]
        if len(rest) != 1:
            die(HELP["plan"])
        try:
            raw = sys.stdin.buffer.read(PLAN_BODY_LIMIT + 1) if rest[0] == "-" else open(rest[0], "rb").read(PLAN_BODY_LIMIT + 1)
        except OSError:
            die("cannot read the manifest file")
        if len(raw) > PLAN_BODY_LIMIT:
            die(f"the manifest is larger than {PLAN_BODY_LIMIT} bytes")
        try:
            manifest = json.loads(raw.decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            die("the manifest is not valid JSON")
        code, r = call(base, key, "/v1/plans",
                       {"manifest": manifest, "source": f"{os.environ.get('USER', '?')}@{socket.gethostname()}"})
        if code != 202:
            _plan_refusal(code, r)
        if not wait:
            print(r["plan"])
            print("asb: pending; the human must approve it on the approval page", file=sys.stderr)
            return 0
        print("asb: waiting for the human to read and approve the plan...", file=sys.stderr)
        end = time.time() + r["expires_in"] + 15
        while time.time() < end:
            code, r2 = call(base, key, f"/v1/requests/{r['id']}?wait=25")
            st = r2.get("status")
            if st == "approved" and isinstance(r2.get("plan"), dict):
                pl = r2["plan"]
                print(pl["plan"])
                print(f"asb: approved for {_plan_when(pl['granted_s'])}, until {_safe_text(pl['expires_at'])}; "
                      "after that, submit a new plan", file=sys.stderr)
                return 0
            if st in ("denied", "expired", "failed", "released"):
                die(f"plan {st}" + (f": {_srv(r2['error'])}" if r2.get("error") else ""), status_exit(st))
        die("timed out waiting for approval", EXIT_EXPIRED)
    if sub == "list":
        if rest:
            die(HELP["plan"])
        code, r = call(base, key, "/v1/plans")
        if code != 200:
            _plan_refusal(code, r)
        if as_json:
            print(json.dumps(r["plans"], indent=2))
            return 0
        if not r["plans"]:
            print("asb: no plans", file=sys.stderr)
            return EXIT_NOT_FOUND
        print("ID\tSTATE\tLEFT\tUSES\tSECRETS", file=sys.stderr)
        for v in r["plans"]:
            print(f"{v['id']}\t{v['status']}\t{_plan_when(v['left_s'])}\t{v['uses']['used']}/{v['uses']['max']}\t"
                  f"{','.join(v['secrets'])}")
        return 0
    if len(rest) != 1:
        die(HELP["plan"])
    pid = _plan_id(rest[0])
    if sub == "status":
        code, r = call(base, key, f"/v1/plans/{pid}")
        if code != 200:
            _plan_refusal(code, r)
        if as_json:
            print(json.dumps(r, indent=2))
        else:
            _plan_print(r)
        return 0
    code, r = call(base, key, f"/v1/plans/{pid}/close", {})
    if code != 200:
        _plan_refusal(code, r)
    print(f"closed: {pid}")
    return 0


