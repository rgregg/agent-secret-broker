    (re.compile(r"^perl$"), {"-I", "-M", "-m"}, {"-e", "-E"}, set()),
    (re.compile(r"^php$"), {"-d", "-c", "-z"}, {"-r"}, set()),
    (re.compile(r"^(?:pwsh|powershell)$"), set(), {"-c", "-command", "-encodedcommand", "-e"}, set()),
    (re.compile(r"^(?:lua|luajit)$"), {"-l"}, {"-e"}, set()),
    (re.compile(r"^Rscript$"), set(), {"-e"}, set()),
)
SCRIPT_FILE_FLAGS = {"php": {"-f"}, "awk": {"-f", "--file"}, "gawk": {"-f", "--file"}, "mawk": {"-f"},
                     "sed": {"-f", "--file"}, "pwsh": {"-file", "-f"}, "powershell": {"-file", "-f"}}
_AWK_LIKE = re.compile(r"^(?:awk|gawk|mawk|sed)$")
_RUNNERS = re.compile(r"^(?:deno|bun)$")


def _strip_wrappers(argv):
    """argv without leading wrapper commands (env VAR=.., sudo, timeout 5, ...)."""
    i = 0
    while i < len(argv):
        w = os.path.basename(argv[i])
        if w not in SCRIPT_WRAPPERS:
            break
        valued, positional = SCRIPT_WRAPPERS[w]
        i += 1
        while i < len(argv):
            a = argv[i]
            if a == "--":
                i += 1
                break
            if w == "env" and "=" in a and not a.startswith("-"):
                i += 1
            elif a.startswith("-") and len(a) > 1:
                i += 2 if a in valued else 1
            else:
                break
        i += positional
    return argv[i:]


def _script_args(name, args):
    """-> ("file", [candidate paths]) | ("inline", None) | ("stdin", None) | ("none", None)
    for the arguments of a recognised interpreter."""
    spec = next((x for x in SCRIPT_INTERPRETERS if x[0].match(name)), None)
    is_awk = bool(_AWK_LIKE.match(name))
    if spec is None and not is_awk and not _RUNNERS.match(name):
        return None
    if _RUNNERS.match(name):
        # deno run [opts] file | deno eval ... | bun [run] file
        sub = args[0] if args else ""
        if sub == "eval":
            return ("inline", None)
        rest = args[1:] if sub in ("run", "x") else args
        for i, a in enumerate(rest):
            if a == "-":
                return ("stdin", None)
            if not a.startswith("-"):
                return ("file", [a])
        return ("none", None)
    if is_awk:
        files, i = [], 0
        ffl = SCRIPT_FILE_FLAGS[name] if name in SCRIPT_FILE_FLAGS else SCRIPT_FILE_FLAGS["awk"]
        inline = False
        while i < len(args):
            a = args[i]
            if a in ffl and i + 1 < len(args):
                files.append(args[i + 1])
                i += 2
                continue
            if a.startswith("--file="):
                files.append(a.split("=", 1)[1])
            elif a in ("-e", "--expression", "--source"):
                inline, i = True, i + 1
            elif a.startswith("-") and a != "-":
                pass
            elif not files and not inline:
                return ("inline", None)             # the program text is the first operand
            else:
                break
            i += 1
        return ("file", files) if files else ("inline" if inline else "none", None)
    _, valued, inline_flags, stdin_flags = spec
    short_inline = {f[1] for f in inline_flags if len(f) == 2}
    short_stdin = {f[1] for f in stdin_flags if len(f) == 2}
    ffl = SCRIPT_FILE_FLAGS.get(name, set())
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--":
            return ("file", [args[i + 1]]) if i + 1 < len(args) else ("none", None)
        if a == "-":
            return ("stdin", None)
        if a in ffl and i + 1 < len(args):
            return ("file", [args[i + 1]])
        if a in inline_flags or a.lower() in inline_flags:
            return ("inline", None)
        if a in stdin_flags:
            return ("stdin", None)
        if a in valued:
            i += 2
            continue
        if name == "perl" and re.match(r"^-[A-Za-z]*[eE]$", a):
            return ("inline", None)
        if re.match(r"^-[A-Za-z]+$", a) and len(a) > 2 and name != "perl":
            letters = a[1:]
            if short_inline & set(letters):
                return ("inline", None)
            if short_stdin & set(letters):
                return ("stdin", None)
        elif a.startswith("-") or a.startswith("+"):
            if name == "perl" and re.match(r"^-[eE]", a):
                return ("inline", None)
            if name.startswith("python") and re.match(r"^-[cm]", a):
                return ("inline", None)
        else:
            return ("file", [a])
        i += 1
    return ("none", None)


def _refused(path):
    for r in SCRIPT_REFUSED:
        base = os.path.expanduser(r)
        if path == base or path.startswith(base.rstrip("/") + "/"):
            return True
    return False


def _printable(path):
    return "".join(c if c.isprintable() and c not in "\u202a\u202b\u202c\u202d\u202e\u2066\u2067\u2068\u2069"
                   else "?" for c in path)[:300]


def _read_script(path, require_text, via_path_lookup=False):
    """-> entry dict, or None to ignore (not a file / not a script worth reporting).
    `path` is the path as named in the command; one realpath is applied."""
    try:
        absolute = os.path.abspath(os.path.expanduser(path))
        real = os.path.realpath(absolute)
    except (OSError, ValueError):
        return {"path": _printable(path), "unreadable": "missing"}
    shown = _printable(real)
    if _refused(absolute) or _refused(real):
        return {"path": shown, "unreadable": "refused"}
    try:
        st = os.stat(real)
    except FileNotFoundError:
        return None if require_text else {"path": shown, "unreadable": "missing"}
    except PermissionError:
        return {"path": shown, "unreadable": "permission"}
    except OSError:
        return {"path": shown, "unreadable": "missing"}
    import stat as _stat
    if not _stat.S_ISREG(st.st_mode):
        return None                             # directory, device, fifo: nothing to read
    try:
        fd = os.open(real, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0))
    except PermissionError:
        return {"path": shown, "unreadable": "permission"}
    except OSError:
        return {"path": shown, "unreadable": "missing"}
    with os.fdopen(fd, "rb") as f:
        head = f.read(SCRIPT_TEXT_BYTES + 4)[:SCRIPT_TEXT_BYTES + 4]
        text_part = head[:SCRIPT_TEXT_BYTES]
        is_text = _looks_text(text_part)
        if require_text and (not is_text or (via_path_lookup and not text_part.startswith(b"#!"))):
            return None                         # a compiled program: nothing to show, not worth a marker
        if st.st_size > SCRIPT_HASH_MAX:
            return {"path": shown, "unreadable": "too_large"}
        if not is_text:
            return {"path": shown, "unreadable": "binary"}
        h = hashlib.sha256(head)
        total = len(head)
        while True:
            chunk = f.read(1 << 20)
            if not chunk:
                break
            h.update(chunk)
            total += len(chunk)
    text = text_part.decode("utf-8", "ignore")      # a multi-byte character cut at the limit is dropped
    return {"path": shown, "size": total, "sha256": h.hexdigest(), "text": text,
            "truncated": total > SCRIPT_TEXT_BYTES}


def _looks_text(b):
    if b"\x00" in b:
        return False
    s = b.decode("utf-8", "replace")
    return not s or s.count(chr(0xfffd)) * 10 <= len(s) * 3


def find_scripts(argv):
    """Script entries for the `scripts` field of an env-mode request ([] when the
    command runs no script we can find). Reads files, never executes anything."""
    cmd = _strip_wrappers(list(argv))
    if not cmd:
        return []
    name = os.path.basename(cmd[0])
    found = _script_args(name, cmd[1:])
    entries, seen = [], set()

    def add(e):
        if e is None:
            return
        key = e.get("path") or "stdin"
        if key in seen or len(entries) >= SCRIPT_MAX_FILES:
            return
        seen.add(key)
        entries.append(e)
    if found is not None:
        kind, paths = found
        if kind == "stdin":
            add({"stdin": True})
        elif kind == "none" and not name.startswith(("sed", "awk", "gawk", "mawk")):
            add({"stdin": True})                  # an interpreter with nothing to run reads stdin
        elif kind == "file":
            for p in paths:
                if p == "-" or p in ("/dev/stdin", "/proc/self/fd/0") or p.startswith("/dev/fd/"):
                    add({"stdin": True})
                else:
                    add(_read_script(p, require_text=False))
        return entries
    # not an interpreter: is argv[0] itself a script?
    if os.path.isabs(cmd[0]) or "/" in cmd[0]:
        add(_read_script(cmd[0], require_text=True))
    else:
        import shutil
        hit = shutil.which(cmd[0])
        if hit:
            add(_read_script(hit, require_text=True, via_path_lookup=True))
    return entries


def script_digest(path):
    """sha256 of the whole file as it is now, or None if it cannot be read."""
    try:
        h = hashlib.sha256()
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                h.update(chunk)
        return h.hexdigest()
    except OSError:
        return None


def changed_script(entries):
    """The path of the first reported script whose content differs now, else None."""
    for e in entries:
        if e.get("sha256") and script_digest(e["path"]) != e["sha256"]:
            return e["path"]
    return None


def mask(text, values):
    for v in sorted(values, key=len, reverse=True):
        if len(v) >= 6:
            text = text.replace(v, "***")
    return text


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if argv[0] == "guide":
        print(GUIDE)
        return 0
    if argv[0] == "help":
        topic = argv[1] if len(argv) > 1 else None
        if topic is None:
            print(__doc__)
        elif topic in HELP:
            print(HELP[topic])
        else:
            die(f"no help for {topic!r}; commands: {', '.join(k for k in HELP if k != 'run')}")
        return 0
    if argv[0] in HELP and argv[0] != "run":
        # Flags are never credential names or values: --help anywhere before an
        # http body/header value, or anywhere for the commands without free text.
        scan = argv[1:4] if argv[0] == "http" else argv[1:]
        if any(a in ("-h", "--help") for a in scan):
            print(HELP[argv[0]])
            return 0
    if argv[0] == "ssh-agent":
        rest, sock = argv[1:], None
        if rest[:1] == ["--socket"]:
            if len(rest) < 2:
                die(HELP["ssh-agent"])
            sock, rest = rest[1], rest[2:]
        if rest[:1] not in ([], ["--"]) or (rest[:1] == ["--"] and len(rest) < 2):
            die(HELP["ssh-agent"])
        return run_ssh_agent(rest[1:], sock)

    if argv[0] in ("store", "update"):
        if len(argv) < 2:
            die(HELP[argv[0]])
        ssh = "--ssh" in argv[2:] and argv[0] == "store"
        if ssh:
            argv = [a for a in argv if a != "--ssh"]
        name, op = check_name(argv[1]), "create" if argv[0] == "store" else "update"
        allowed = {"--field": "field", "--item": "item", "--var": "var", "--hosts": "hosts"}
        if op == "update":
            allowed = {"--var": "var"}
        f = parse_flags(argv[2:], allowed)
        payload = {"mode": "store", "names": [name], "op": op, "value": read_value()}
        if ssh:
            payload["ssh"] = True
        for k in ("field", "item", "var"):
            if f.get(k):
                payload[k] = f[k]
        if op == "create":
            if not f.get("hosts") and not ssh:
                die("store needs --hosts (the hosts this credential may be used against)\n" + HELP["store"])
            payload["allowed_hosts"] = [h for h in (f.get("hosts") or "").split(",") if h]
        r = obtain(payload)["stored"]
        print(f"stored: {r['name']} ({r['op']}) -> item {r['item']!r} field {r['field']}")
        return 0

    if argv[0] == "fingerprint":
        if len(argv) != 2:
            die(HELP["fingerprint"])
        import hashlib
        import socket
        import ssl
        host, _, port = argv[1].partition(":")
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
        try:
            with socket.create_connection((host, int(port or 443)), timeout=10) as raw:
                with ctx.wrap_socket(raw, server_hostname=host) as tls:
                    der = tls.getpeercert(binary_form=True)
        except (OSError, ValueError) as e:
            die(f"could not read a certificate from {argv[1]}: {e}")
        print("sha256:" + hashlib.sha256(der).hexdigest())
        print("asb: put this in the item's broker metadata as "
              '"tls_fingerprint" only after checking it is the device you mean.', file=sys.stderr)
        return 0

    if argv[0] == "list":
        if argv[1:] not in ([], ["--json"]):
            die(HELP["list"])
        base, key = config()
        code, r = call(base, key, "/v1/secrets")
        if code != 200:
            die(r.get("error", f"broker returned {code}"), EXIT_BROKER)
        if argv[1:] == ["--json"]:
            print(json.dumps(r["secrets"], indent=2))
            return 0
        if not r["secrets"]:
            print("asb: no credentials are configured", file=sys.stderr)
            return EXIT_NOT_FOUND
        print("NAME\tVARS\tHOSTS   (columns; use --json for scripts)", file=sys.stderr)
        for s in r["secrets"]:
            print(f"{s['name']}\t{','.join(s['vars'])}\t{','.join(s['allowed_hosts'])}")
        return 0

    if argv[0] == "status":
        if argv[1:] not in ([], ["--json"]):
            die(HELP["status"])
        base, key = config()
        code, r = call(base, key, "/v1/status", timeout=15)
        if code != 200:
            die(r.get("error", f"broker returned {code}"), EXIT_BROKER)
        if argv[1:] == ["--json"]:
            print(json.dumps(r, indent=2))
            return 0
        c, b = r["catalog"], r["backend"]
        d, rem = divmod(int(r["uptime_s"]), 86400)
        h, rem = divmod(rem, 3600)
        up = (f"{d}d " if d else "") + f"{h}h {rem // 60}m"
        print(f"version:  {r['version']} (built {r['build_time']})")
        print(f"uptime:   {up} (since {r['started_at']})")
        print(f"catalog:  {c['count']} secrets, {c['invalid']} invalid, {c['adopted']} adopted"
              f" (loaded {c['loaded_at'] or 'never'})")
        print(f"backend:  {b['type']} {'ok' if b['ok'] else 'FAILING'}")
        print(f"notify:   {', '.join(r['notifiers']) or 'none'}")
        return 0

    if argv[0] == "audit":
        return run_audit(argv[1:])

    if argv[0] == "which":
        if len(argv) != 2:
            die(HELP["which"])
        check_name(argv[1], "HOST")
        base, key = config()
        target = urllib.parse.quote(argv[1], safe="")
        param = "url" if "://" in argv[1] else "host"
        code, r = call(base, key, f"/v1/secrets?{param}={target}")
        if code != 200:
            die(r.get("error", f"broker returned {code}"), EXIT_BROKER)
        for s in r["secrets"]:
            print(f"{s['name']}\t{','.join(s['vars'])}")
        if not r["secrets"]:
            print(f"asb: no credential available for {r['host']}. "
                  "See `asb list`, or add one with `asb store` "
                  "(`asb guide`).", file=sys.stderr)
            return EXIT_NOT_FOUND
        return 0

    if argv[0] == "http":
        if len(argv) < 4:
            die(HELP["http"])
        check_name(argv[1])
        names, method, url, rest = argv[1].split(","), argv[2], argv[3], argv[4:]
        headers, body = {}, {}
        while rest:
            if rest[0] == "-H" and len(rest) > 1:
                k, _, v = rest[1].partition(":")
                headers[k.strip()] = v.strip()
                rest = rest[2:]
            elif rest[0] == "-d" and len(rest) > 1:
                body, rest = read_body(rest[1]), rest[2:]
            else:
                die(f"unexpected argument {rest[0]!r}")
        r = obtain({"mode": "http", "names": names, "method": method, "url": url,
                    "headers": headers, **body})["http"]
        print(f"HTTP {r['status']}", file=sys.stderr)
        sys.stdout.write(r["body"])
        return 0 if r["status"] < 400 else EXIT_HTTP_ERROR

    if "--" not in argv:
        die(f"unknown command {argv[0]!r}.\ncommands: list, which, status, audit, http, store, update, "
            "ssh-agent, fingerprint, help, guide; or: asb NAME -- command\n"
            "start with `asb guide`")
    i = argv.index("--")
    names, cmd = argv[0].split(",") if i == 1 else None, argv[i + 1:]
    if not names or not cmd:
        die(HELP["run"])
    for n in names:
        check_name(n)
    payload = {"mode": "env", "names": names, "argv": cmd}
    try:
        scripts = find_scripts(cmd)
    except Exception:  # noqa: BLE001  (script detection is a courtesy; it never blocks a request)
        scripts = []
    if scripts:
        payload["scripts"] = scripts
    env = obtain(payload)["env"]
    moved = changed_script(scripts)
    if moved:
        # advisory: catches an edit between the request and the run, nothing more
        die(f"script {moved} changed after it was reviewed", EXIT_SCRIPT_CHANGED)
    p = subprocess.run(cmd, env={**os.environ, **env}, capture_output=True, text=True)
    sys.stdout.write(mask(p.stdout, env.values()))
    sys.stderr.write(mask(p.stderr, env.values()))
    return p.returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
