        while i < len(args):
            a = args[i]
            if a in ffl and i + 1 < len(args):
                files.append(args[i + 1])
                i += 2
                continue
            if a.startswith("--file="):
                files.append(a.split("=", 1)[1])
            elif a in ("-e", "--expression", "--source") or a.startswith(("--expression=", "--source=")):
                inline = True
                if a in ("-e", "--expression", "--source"):
                    i += 1
            elif a.startswith("-") and a != "-":
                pass
            elif not files and not inline:
                return ("inline", None)             # the program text is the first operand
            else:
                break
            i += 1
        if files and inline:
            return ("unknown", None)
        return ("file", files) if files else ("inline" if inline else "none", None)
    _, valued, inline_flags, stdin_flags = spec
    short_inline = {f[1] for f in inline_flags if len(f) == 2}
    short_stdin = {f[1] for f in stdin_flags if len(f) == 2}
    ffl = SCRIPT_FILE_FLAGS.get(name, set())
    i = 0
    while i < len(args):
        a = args[i]
        if lo and (a in lo or a.split("=")[0] in lo or (len(a) > 2 and not a.startswith("--") and a[:2] in lo)):
            return ("unknown", None)                # loads code that is not a reported script
        if a == "--":
            return ("file", [args[i + 1]]) if i + 1 < len(args) else ("none", None)
        if a == "-":
            return ("stdin", None)
        if a in ffl and i + 1 < len(args):
            return ("file", [args[i + 1]])
        if a in inline_flags or a.lower() in inline_flags:
            return ("inline", args[i + 1] if i + 1 < len(args) else None)
        if a in stdin_flags:
            return ("stdin", None)
        if a in valued:
            i += 2
            continue
        if name == "perl" and re.match(r"^-[A-Za-z]*[eE]$", a):
            return ("inline", None)
        if re.match(r"^-[A-Za-z]+$", a) and len(a) > 2 and name != "perl":
            letters = a[1:]
            if short_inline & set(letters):
                return ("inline", args[i + 1] if i + 1 < len(args) else None)
            if short_stdin & set(letters):
                return ("stdin", None)
        elif a.startswith("-") or a.startswith("+"):
            if name == "perl" and re.match(r"^-[eE]", a):
                return ("inline", None)
            if name.startswith("python") and re.match(r"^-[cm]", a):
                return ("inline", None)
        else:
            return ("file", [a])
        i += 1
    return ("none", None)


def _loader_opts(name):
    """Interpreter options that load code which is not a reported script."""
    if name in ("node", "nodejs"):
        return {"-r", "--require", "--import", "--loader", "--experimental-loader"}
    if name == "ruby":
        return {"-r", "-I"}
    if name == "perl":
        return {"-M", "-m", "-I"}
    if name == "php":
        return {"-d", "-c", "-z"}
    if name in ("lua", "luajit"):
        return {"-l"}
    if re.match(r"^(?:%s)$" % _SHELLS, name):
        return {"--rcfile", "--init-file"}
    return set()


def _canon_long(nm, spec):
    names = spec["l"] | spec["lv"]
    if nm in names:
        return nm
    hits = [n for n in names if len(nm) > 2 and n.startswith(nm)]
    return hits[0] if len(hits) == 1 else None


def _parse_one(args, i, spec, seen, vals):
    """Parse the option at args[i] -> index after it, or None when not recognised."""
    a = args[i]
    if a.startswith("--"):
        nm, eq, val = a.partition("=")
        canon = _canon_long(nm, spec)
        if canon is None:
            return None
        seen.add(canon)
        if canon in spec["lv"]:
            if eq:
                vals.append((canon, val))
                return i + 1
            if i + 1 >= len(args):
                return None
            vals.append((canon, args[i + 1]))
            return i + 2
        return i + 1
    if spec["digits"] and re.fullmatch(r"-\d+", a):
        return i + 1
    j, nxt = 1, i + 1
    while j < len(a):
        c = a[j]
        seen.add("-" + c)
        if c in spec["sv"]:
            rest = a[j + 1:]
            if rest:
                vals.append(("-" + c, rest))
                return nxt
            if nxt >= len(args):
                return None
            vals.append(("-" + c, args[nxt]))
            return nxt + 1
        if c in spec["so"]:
            vals.append(("-" + c, a[j + 1:]))
            return nxt
        if c not in spec["s"]:
            return None
        j += 1
    return nxt


def _parse_opts(args, spec):
    """-> (operands, seen options, [(option, value)]) or None when an option is not
    recognised (or the wrapper changes the directory/filesystem the command runs in)."""
    i, seen, vals = 0, set(), []
    while i < len(args):
        a = args[i]
        if a == "--":
            i += 1
            break
        if a == "-" and spec["dash"]:
            seen.add("-")
            i += 1
        elif a.startswith("-") and len(a) > 1:
            i = _parse_one(args, i, spec, seen, vals)
            if i is None:
                return None
        else:
            break
    if spec["chdir"] and ("*" in spec["chdir"] or seen & spec["chdir"]):
        return None
    return args[i:], seen, vals


def _env_unwrap(args, splits):
    """env's options and VAR=value words skipped -> (command argv, splits used), or
    (None, splits) when something is not recognised. An -S/--split-string value is
    split with shlex and parsing carries on over the pieces; a value with a
    backslash, $, # or newline (GNU env's own escapes and comments) is refused."""
    i, done, seen, vals = 0, False, set(), []
    while i < len(args):
        a = args[i]
        if not done and a == "--":
            done, i = True, i + 1
        elif not done and a == "-":
            i += 1
        elif not done and a.startswith("-") and len(a) > 1:
            n0 = len(vals)
            i = _parse_one(args, i, _ENV_OPTS, seen, vals)
            if i is None or seen & _ENV_OPTS["chdir"]:
                return None, splits
            for k, v in vals[n0:]:
                if k in ("-S", "--split-string"):
                    splits += 1
                    if re.search(r"[\\$#\n\r\0]", v):
                        return None, splits
                    try:
                        pieces = shlex.split(v)
                    except ValueError:
                        return None, splits
                    args, i = pieces + args[i:], 0
        else:
            ok = _assignment(a)
            if ok is None:
                break
            if not ok:
                return None, splits
            i += 1
    return args[i:], splits


def _shell_string(s, depth):
    """A restricted shell command line -> ([(path, strict)], understood). Anything
    beyond plain words, quotes, && || ; | and a lone 2>&1 is not understood; every
    command in it must itself be understood."""
    if depth > MAX_SPLIT_DEPTH or not isinstance(s, str):
        return [], False
    if re.search(r"[\n\r#`$\\\0]", s) or "<<" in s or "<(" in s or ">(" in s:
        return [], False
    segs, word, i, n = [[]], None, 0, len(s)
    while i < n:
        c = s[i]
        if c in " \t":
            if word is not None:
                segs[-1].append("".join(word))
                word = None
            i += 1
        elif c in "'\"":
            j = s.find(c, i + 1)
            if j < 0:
                return [], False
            word = (word or []) + list(s[i + 1:j])
            i = j + 1
        elif c in "&|;":
            two = s[i:i + 2]
            if two in (";;", "|&") or (c == "&" and two != "&&"):
                return [], False
            if word is not None:
                segs[-1].append("".join(word))
                word = None
            segs.append([])
            i += len(two) if two in ("&&", "||") else 1
        elif c in "<>":
            if c == ">" and word == ["2"] and s.startswith(">&1", i) and (i + 3 == n or s[i + 3] in " \t&|;"):
                word = None
                i += 3
            else:
                return [], False
        elif c in "(){}":
            return [], False
        else:
            word = (word or []) + [c]
            i += 1
    if word is not None:
        segs[-1].append("".join(word))
    out, ok = [], True
    for seg in segs:
        while seg and _assignment(seg[0]) is not None:      # the shell performs VAR=value prefixes
            if not _assignment(seg[0]):
                return out, False
            seg = seg[1:]
        if not seg or seg[0] in _SHELL_RESERVED:
            return out, False
        found, good = _analyze(seg, depth + 1)
        out += [x for x in found if x not in out]
        ok = ok and good
    return out, ok


def _bad_path(p):
    return "\0" in p or "\n" in p or ".." in p.split("/") or any(c in p for c in "*?[")


def _in_system_bin(p):
    return not _bad_path(p) and os.path.isabs(p) and os.path.normpath(p).startswith(_SYSTEM_BIN)


def _analyze(argv, depth=0, trace=None):
    """-> ([(path, strict)], understood). `strict` marks argv[0] itself being the
    script (a client may skip a compiled program); "-" is code read from stdin.
    understood is True only when every command in argv is positively recognised: a
    plain program, an interpreter with a script file or a restricted shell string,
    or a known wrapper whose command is understood. See argv_runs_script."""
    out = []

    def add(p, strict=False):
        if (p, strict) not in out:
            out.append((p, strict))

    def merge(items):
        for it in items:
            add(*it)
    cmd, hops, splits = list(argv), 0, 0
    while True:
        if not cmd:
            return out, False                   # nothing left to run: not understood
        hops += 1
        if hops > MAX_HOPS or depth + splits > MAX_SPLIT_DEPTH:
            return out, False
        a0, args = cmd[0], cmd[1:]
        if _bad_path(a0):
            return out, False
        if _assignment(a0) is not None:                     # only env and shell strings may assign
            return out, False
        name = os.path.basename(a0)
        simple = "/" not in a0 or _in_system_bin(a0)        # bare name or a standard system path
        if simple and name == "env":
            nxt, splits = _env_unwrap(args, splits)
            if nxt is None or depth + splits > MAX_SPLIT_DEPTH:
                return out, False
            if not nxt:
                # a bare `env` (plain options only) just prints the environment
                return out, hops == 1 and depth == 0 and splits == 0 and not any("=" in a for a in args)
            cmd = nxt
            continue
        if simple and name in SCRIPT_WRAPPERS:
            parsed = _parse_opts(args, SCRIPT_WRAPPERS[name])
            if parsed is None:
                return out, False
            rest, seen, _ = parsed
            spec = SCRIPT_WRAPPERS[name]
            if not (seen & spec["pos_unless"]):
                if len(rest) < spec["pos"]:
                    return out, False
                rest = rest[spec["pos"]:]
            cmd = rest
            continue
        break
    if trace is not None:
        trace["cmd"] = cmd
    found = _script_args(name, args) if ("/" not in a0 or os.path.isabs(a0)) else None
    if found is not None:
        kind, payload = found
        if kind == "stdin" or (kind == "none" and not name.startswith(("sed", "awk", "gawk", "mawk"))):
            add("-")
            return out, True
        if kind == "file":
            for p in payload:
                add(p)
            return out, True
        if kind == "inline" and re.match(r"^(?:ba|z|da|k|a)?sh$", name):
            found2, good = _shell_string(payload, depth + 1)
            merge(found2)
            return out, good
        if kind == "unknown":                               # still report the script file(s), if any
            again = _script_args(name, args, False)
            if again and again[0] == "file":
                merge((q, False) for q in again[1])
        return out, False                                   # other inline code, unknown options, bare sed/awk
    if a0.endswith(_SCRIPT_EXT) or ("/" in a0 and not _in_system_bin(a0)):
        add(a0, True)                                       # the command is itself a script file
        return out, True
    if simple and name in PLAIN_PROGRAMS:
        return out, _plain_ok(name, args)
    return out, False


def argv_runs_script(argv):
    """The script files `argv` appears to execute, in order ([] when none): an
    interpreter's script operand, a script run directly (a script extension or a
    path outside /bin, /usr/bin, /sbin, /usr/sbin, compared after normpath), looked
    through wrappers and the commands of restricted shell strings. "-" is code read
    from standard input. Whether the whole command is understood is separate:
    see argv_understood."""
    if not isinstance(argv, list) or not all(isinstance(a, str) for a in argv):
        return []
    return [p for p, _ in _analyze(argv)[0]]


def argv_understood(argv):
    """True only when every command in `argv` is positively recognised (see
    _analyze). Anything else is not visible: the broker prompts for it."""
    if not isinstance(argv, list) or not all(isinstance(a, str) for a in argv):
        return False
    return _analyze(argv)[1]
# --- shared-detection:end ---


def _refused(path):
    for r in SCRIPT_REFUSED:
        base = os.path.expanduser(r)
        if path == base or path.startswith(base.rstrip("/") + "/"):
            return True
    return False


def _printable(path):
    return "".join(c if c.isprintable() and c not in "\u202a\u202b\u202c\u202d\u202e\u2066\u2067\u2068\u2069"
                   else "?" for c in path)[:300]


def _read_script(path, require_text, via_path_lookup=False):
    """-> entry dict, or None to ignore (not a file / not a script worth reporting).
    `path` is the path as named in the command; one realpath is applied."""
    try:
        absolute = os.path.abspath(os.path.expanduser(path))
        real = os.path.realpath(absolute)
    except (OSError, ValueError):
        return {"path": _printable(path), "unreadable": "missing"}
    shown = _printable(real)
    given = _printable(os.path.normpath(absolute))
    extra = {"given": given} if given != shown else {}     # the path as named, before symlinks
    if _refused(absolute) or _refused(real):
        return {"path": shown, "unreadable": "refused", **extra}
    try:
        st = os.stat(real)
    except FileNotFoundError:
        return None if require_text else {"path": shown, "unreadable": "missing"}
    except PermissionError:
        return {"path": shown, "unreadable": "permission", **extra}
    except OSError:
        return {"path": shown, "unreadable": "missing", **extra}
    import stat as _stat
    if not _stat.S_ISREG(st.st_mode):
        return None                             # directory, device, fifo: nothing to read
    try:
        fd = os.open(real, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0))
    except PermissionError:
        return {"path": shown, "unreadable": "permission", **extra}
    except OSError:
        return {"path": shown, "unreadable": "missing", **extra}
    with os.fdopen(fd, "rb") as f:
        head = f.read(SCRIPT_TEXT_BYTES + 4)[:SCRIPT_TEXT_BYTES + 4]
        text_part = head[:SCRIPT_TEXT_BYTES]
        is_text = _looks_text(text_part)
        if require_text and (not is_text or (via_path_lookup and not text_part.startswith(b"#!"))):
            return None                         # a compiled program: nothing to show, not worth a marker
        if st.st_size > SCRIPT_HASH_MAX:
            return {"path": shown, "unreadable": "too_large", **extra}
        if not is_text:
            return {"path": shown, "unreadable": "binary", **extra}
        h = hashlib.sha256(head)
        total = len(head)
        while True:
            chunk = f.read(1 << 20)
            if not chunk:
                break
            h.update(chunk)
            total += len(chunk)
    text = text_part.decode("utf-8", "ignore")      # a multi-byte character cut at the limit is dropped
    return {"path": shown, "size": total, "sha256": h.hexdigest(), "text": text,
            "truncated": total > SCRIPT_TEXT_BYTES, **extra}


def _looks_text(b):
    if b"\x00" in b:
        return False
    s = b.decode("utf-8", "replace")
    return not s or s.count(chr(0xfffd)) * 10 <= len(s) * 3


_LAUNCHERS = frozenset(("env sudo doas nohup time timeout nice stdbuf exec command setsid chrt taskset ionice xargs "
                        "busybox strace ltrace nsenter unshare flock su runuser setpriv chroot numactl watch parallel "
                        "script").split())


def find_scripts(argv):
    """Script entries for the `scripts` field of an env-mode request ([] when the
    command runs no script we can find). Reads files, never executes anything.
    What counts as a script is decided by argv_runs_script's rules (the broker
    applies the same ones to the argv it receives)."""
    argv = list(argv)
    trace = {}
    items, _understood = _analyze(argv, 0, trace)       # the broker decides whether it is understood
    entries, seen = [], set()

    def add(e):
        if e is None:
            return
        key = e.get("path") or "stdin"
        if key in seen or len(entries) >= SCRIPT_MAX_FILES:
            return
        seen.add(key)
        entries.append(e)
    if not items and not _understood and os.path.basename(argv[0] if argv else "") in _LAUNCHERS:
        # a launcher the broker does not understand: still show the script it appears to run
        for k in range(1, len(argv)):
            items, _ok = _analyze(argv[k:])
            if items:
                break
    import shutil
    for p, strict in items:
        if p == "-" or p in ("/dev/stdin", "/proc/self/fd/0") or p.startswith("/dev/fd/"):
            add({"stdin": True})
        elif "/" not in p and shutil.which(p) and strict:
            add(_read_script(shutil.which(p), require_text=True, via_path_lookup=True))   # bare name on PATH
        else:
            add(_read_script(p, require_text=strict))
    cmd = trace.get("cmd") or []
    if not items and cmd and "/" not in cmd[0] and _script_args(cmd[0], cmd[1:]) is None:   # not an interpreter
        # a bare name that is a script found on PATH (a courtesy: the broker does not require it)
        import shutil
        hit = shutil.which(cmd[0])
        if hit:
            add(_read_script(hit, require_text=True, via_path_lookup=True))
    return entries


def script_digest(path):
    """sha256 of the whole file as it is now, or None if it cannot be read."""
    try:
        h = hashlib.sha256()
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                h.update(chunk)
        return h.hexdigest()
    except OSError:
        return None


def changed_script(entries):
    """The path of the first reported script whose content differs now, else None."""
    for e in entries:
        if e.get("sha256") and script_digest(e["path"]) != e["sha256"]:
            return e["path"]
    return None


def mask(text, values):
    for v in sorted(values, key=len, reverse=True):
        if len(v) >= 6:
            text = text.replace(v, "***")
    return text


# -- agent-setup: instruction block for coding agents (local only) --------------
AGENT_BLOCK_VERSION = 1
AGENT_MARK = "asb:agent-setup"
AGENT_BLOCK_BODY = """## Credentials (asb)

Use the secret broker CLI `asb` (on PATH) for any credential. Never read credential
files or hunt for API keys, and never ask for a secret in chat.
- `asb which HOST|URL` / `asb list` find the credential and its {{VAR}} names (no approval).
- `asb http NAME METHOD URL -H 'Authorization: Bearer {{VAR}}'` makes the call; the value
  never reaches you.
- No credential covers the service: run `asb request-credential`. The human enters the
  value; you never see it.
- Every use asks the human to approve. A denial or timeout is final: stop and tell them
  what you needed.
- Run `asb guide` for the full manual."""
_BEGIN_RE = re.compile(r"<!-- " + AGENT_MARK + r" begin v(\d+) -->")
_END_RE = re.compile(r"<!-- " + AGENT_MARK + r" end -->")
_ANY_MARK_RE = re.compile(r"<!--\s*" + AGENT_MARK + r"\b")
AGENT_NAMES = ("claude", "codex", "copilot")


class SetupError(Exception):
    pass


def agent_block(eol="\n"):
    lines = [f"<!-- {AGENT_MARK} begin v{AGENT_BLOCK_VERSION} -->",
             f"<!-- managed by `asb agent-setup`; edits between the markers are replaced -->"]
    lines += AGENT_BLOCK_BODY.split("\n")
    lines.append(f"<!-- {AGENT_MARK} end -->")
    return eol.join(lines)


def find_block(text):
    """(start, end, version) of the marked block, or None. Raises SetupError if damaged."""
    marks = _ANY_MARK_RE.findall(text)
    begins, ends = list(_BEGIN_RE.finditer(text)), list(_END_RE.finditer(text))
    if not marks and not begins and not ends:
        return None
    if len(marks) != len(begins) + len(ends):
        raise SetupError("a marker line is malformed (expected exactly "
                         f"'<!-- {AGENT_MARK} begin vN -->' and '<!-- {AGENT_MARK} end -->')")
    if len(begins) > 1 or len(ends) > 1:
        raise SetupError("more than one begin/end marker (duplicated block)")
    if begins and not ends:
        raise SetupError("begin marker without an end marker")
    if ends and not begins:
        raise SetupError("end marker without a begin marker")
    b, e = begins[0], ends[0]
    if e.start() < b.end():
        raise SetupError("end marker comes before the begin marker")
    return b.start(), e.end(), int(b.group(1))


def apply_block(text, remove):
    """New text and a status word. Text outside the markers is preserved byte for byte."""
    found = find_block(text)
    eol = "\r\n" if "\r\n" in text else "\n"
    if remove:
        if not found:
            return text, "absent"
        s, e, _ = found
        tail = text[e:]
        for nl in ("\r\n", "\n"):
            if tail.startswith(nl):
                tail = tail[len(nl):]
                break
        head = text[:s]
        if not tail.strip() and head.endswith(eol + eol):
            head = head[:-len(eol)]   # drop the blank separator install added
        return head + tail, "removed"
    block = agent_block(eol)
    if found:
        s, e, v = found
        new = text[:s] + block + text[e:]
        if new == text:
            return text, "unchanged"
        return new, f"updated (v{v} -> v{AGENT_BLOCK_VERSION})"
    if not text:
        return block + eol, "installed"
    sep = "" if text.endswith(("\n", "\r")) else eol
    return text + sep + eol + block + eol, "installed"


def agent_targets(agent, scope, home, cwd, env):
    """(config dir that shows the agent is installed, instruction file path)."""
    if agent == "claude":
        if scope == "user":
            return os.path.join(home, ".claude"), os.path.join(home, ".claude", "CLAUDE.md")
        top, alt = os.path.join(cwd, "CLAUDE.md"), os.path.join(cwd, ".claude", "CLAUDE.md")
        use = alt if (not os.path.lexists(top) and os.path.lexists(alt)) else top
        return cwd, use
    if agent == "codex":
        base = env.get("CODEX_HOME") or os.path.join(home, ".codex")
        if scope == "user":
            return base, os.path.join(base, "AGENTS.md")
        return cwd, os.path.join(cwd, "AGENTS.md")
    base = env.get("COPILOT_HOME") or os.path.join(home, ".copilot")
    if scope == "user":
        return base, os.path.join(base, "copilot-instructions.md")
    return cwd, os.path.join(cwd, ".github", "copilot-instructions.md")


def detect_agents(scope, home, cwd, env):
    """[(agent, why)] for agents that look installed."""
    found = []
    for a in AGENT_NAMES:
        cfg, path = agent_targets(a, scope, home, cwd, env)
        user_cfg = agent_targets(a, "user", home, cwd, env)[0]
        why = None
        if os.path.isdir(user_cfg):
            why = f"config dir {user_cfg}"
        elif shutil.which({"claude": "claude", "codex": "codex", "copilot": "copilot"}[a], path=env.get("PATH")):
            why = f"'{a}' on PATH"
        elif scope == "project" and os.path.lexists(path):
            why = f"existing {path}"
        if why:
            found.append((a, why))
    return found


def plan_target(agent, path, remove, create_ok, scope="user", cwd=None):
    """Read-only planning. Returns dict(path, real, old, new, status, error, exists)."""
    r = {"agent": agent, "path": path, "real": os.path.realpath(path), "old": "", "new": "",
         "status": "", "error": None, "exists": False}
    real = r["real"]
    try:
        if scope == "project":
            root = os.path.realpath(cwd or os.getcwd())
            if os.path.commonpath([root, real]) != root:
                raise SetupError(f"resolves to {real}, outside the project directory {root}; "
                                 "refusing to follow it")
        if os.path.exists(real):
            st = os.stat(real)
            if not stat.S_ISREG(st.st_mode):
                raise SetupError(f"{real} is not a regular file")
            if scope == "user" and os.stat(os.path.dirname(real)).st_uid != os.geteuid():
                raise SetupError(f"directory of {real} is not owned by you; refusing")
            r["exists"] = True
            try:
                with open(real, "rb") as f:
                    raw = f.read()
            except OSError as e:
                raise SetupError(f"cannot read: {e.strerror or e}")
            try:
                r["old"] = raw.decode("utf-8")
            except UnicodeDecodeError:
                raise SetupError("not valid UTF-8 text; leaving it alone")
        elif os.path.islink(path):
            raise SetupError("dangling symlink")
        else:
            parent = os.path.dirname(real)
            if remove:
                r["status"] = "absent (no file)"
                r["new"] = r["old"]
                return r
            if not create_ok and not os.path.isdir(parent):
                r["status"] = "skipped (directory does not exist; use --agent " + agent + " to create it)"
                r["new"] = r["old"]
                r["skip"] = True
                return r
        r["new"], r["status"] = apply_block(r["old"], remove)
        if r["new"] != r["old"]:
            if r["exists"]:
                if not (os.stat(real).st_mode & 0o222) or not os.access(real, os.W_OK):
                    raise SetupError("file is read-only; not changed")
            else:
                d = os.path.dirname(real)
                while d and not os.path.isdir(d):
                    d = os.path.dirname(d)
                if scope == "user" and os.stat(d or ".").st_uid != os.geteuid():
                    raise SetupError(f"{d} is not owned by you; refusing")
                if not os.access(d or ".", os.W_OK):
                    raise SetupError(f"cannot create file: {d} is not writable")
    except SetupError as e:
        r["error"] = str(e)
    return r


def write_target(r):
    """Backup (if the file exists) and replace atomically. The resolved target is written;
    temp and backup files are created exclusively and never follow a symlink."""
    real = r["real"]
    os.makedirs(os.path.dirname(real), exist_ok=True)
    mode = 0o644
    if r["exists"]:
        mode = os.stat(real).st_mode & 0o7777
        stamp, n = time.strftime("%Y%m%d%H%M%S"), 1
        while True:
            bak = f"{real}.asb-bak-{stamp}" + (f"-{n}" if n > 1 else "")
            try:
                fd = os.open(bak, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
                break
            except FileExistsError:   # includes a planted symlink: O_EXCL never follows it
                n += 1
        with os.fdopen(fd, "wb") as out:
            with open(real, "rb") as src:
                out.write(src.read())
            out.flush()
            os.fchmod(out.fileno(), mode)
            os.fsync(out.fileno())
        r["backup"] = bak
    fd, tmp = tempfile.mkstemp(prefix=os.path.basename(real) + ".asb-tmp-", dir=os.path.dirname(real))
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(r["new"].encode("utf-8"))
            f.flush()
            os.fchmod(f.fileno(), mode)
            os.fsync(f.fileno())
        os.replace(tmp, real)
    finally:
        if os.path.lexists(tmp):
            os.unlink(tmp)


def run_agent_setup(args):
    agent, scope, dry, remove = None, "user", False, False
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--dry-run":
            dry = True
        elif a == "--remove":
            remove = True
        elif a in ("-h", "--help"):
            print(HELP["agent-setup"])
            return 0
        elif a in ("--agent", "--scope") and i + 1 < len(args):
            if a == "--agent":
                agent = args[i + 1]
            else:
                scope = args[i + 1]
            i += 1
        else:
            die(f"unexpected argument {a!r}\n" + HELP["agent-setup"])
        i += 1
    if agent is not None and agent not in AGENT_NAMES + ("all",):
        die("--agent must be claude, codex, copilot or all")
    if scope not in ("user", "project"):
        die("--scope must be user or project")
    home, cwd, env = os.path.expanduser("~"), os.getcwd(), os.environ
    if agent is None:
        det = detect_agents(scope, home, cwd, env)
        if not det:
            print("asb: no coding agent found (looked for Claude Code, Codex, GitHub Copilot: "
                  "config directories and programs on PATH); name one with --agent", file=sys.stderr)
            return EXIT_NOT_FOUND
        for a, why in det:
            print(f"found {a}: {why}")
        names, explicit = [a for a, _ in det], False
    else:
        names, explicit = (list(AGENT_NAMES) if agent == "all" else [agent]), True
    plans = [plan_target(a, agent_targets(a, scope, home, cwd, env)[1], remove, explicit, scope, cwd) for a in names]
    for a, p in zip(names, plans):
        if a == "codex" and scope == "user":
            ov = os.path.join(os.path.dirname(p["path"]), "AGENTS.override.md")
            if os.path.exists(ov) and os.path.getsize(ov) > 0:
                print(f"note: {ov} is non-empty and takes precedence over AGENTS.md; "
                      "Codex will not read the block there")
    bad = False
    for p in plans:
        label = f"{p['agent']} ({scope}): {p['path']}"
        if os.path.realpath(p["path"]) != os.path.abspath(p["path"]):
            label += f" -> {p['real']}"
        if p["error"]:
            bad = True
            print(f"{label}: REFUSED: {p['error']}", file=sys.stderr)
            if "marker" in p["error"]:
                print("  fix or delete the damaged asb:agent-setup marker lines by hand, then re-run",
                      file=sys.stderr)
            continue
        print(f"{label}: {p['status']}" + (" (dry run)" if dry and p["new"] != p["old"] else ""))
        if dry and p["new"] != p["old"]:
            fromf = f"a/{p['path']}" if p["exists"] else "/dev/null"
            diff = difflib.unified_diff(p["old"].splitlines(), p["new"].splitlines(),
                                        fromf, f"b/{p['path']}", lineterm="")
            print("\n".join(diff))
    if bad:
        print("asb: nothing was written", file=sys.stderr)
        return EXIT_USAGE
    if not dry:
        for p in plans:
            if p["new"] != p["old"]:
                try:
                    write_target(p)
                except OSError as e:
                    die(f"cannot write {p['path']}: {e.strerror or e}")
                if p.get("backup"):
                    print(f"backup: {p['backup']}")
    return 0


