_NO_SPEC = {"deny_short": "", "deny_long": (), "deny_tokens": (), "deny_at": False, "max_operands": None}


def _plain(**kw):
    return {**_NO_SPEC, **kw}


# Programs that cannot run other commands, with the options that would make them
# read or write files in unusual ways refused.
PLAIN_PROGRAMS = {
    **{n: _plain() for n in ("cat ls head tail wc echo printf date uname uptime df du ps id whoami hostname "
                             "pwd stat jq ping dig nslookup sha256sum md5sum true false test").split()},
    **{n: _plain(deny_short="f", deny_long=("--file",)) for n in ("grep", "egrep", "fgrep")},
    "curl": _plain(deny_short="KToODc", deny_at=True,
                   deny_long=("--config", "--upload-file", "--output", "--remote-name", "--remote-name-all",
                              "--output-dir", "--dump-header", "--cookie-jar", "--create-dirs", "--trace",
                              "--trace-ascii", "--stderr", "--libcurl", "--netrc-file")),
    "wget": _plain(deny_short="iOoaePB", deny_long=("--input-file", "--output-document", "--output-file",
                                                    "--append-output", "--execute", "--config", "--post-file",
                                                    "--directory-prefix", "--use-askpass", "--body-file")),
    "openssl": _plain(deny_tokens=("-engine", "-provider", "-provider-path", "-config", "-propquery")),
    "sort": _plain(deny_short="o", deny_long=("--output", "--compress-program")),
    "uniq": _plain(max_operands=1),
}


def _plain_ok(name, args):
    spec = PLAIN_PROGRAMS[name]
    operands, opts = 0, True
    for a in args:
        if "\0" in a:
            return False
        if spec["deny_at"] and (a.startswith("@") or "=@" in a):
            return False
        if opts and a == "--":
            opts = False
        elif opts and a.startswith("--"):
            nm = a.partition("=")[0]
            if any(nm == d or (len(nm) > 3 and d.startswith(nm)) for d in spec["deny_long"]):
                return False
        elif opts and a.startswith("-") and len(a) > 1:
            if a in spec["deny_tokens"] or (set(a[1:]) & set(spec["deny_short"]) and not a[1:].isdigit()):
                return False
        else:
            operands += 1
    return spec["max_operands"] is None or operands <= spec["max_operands"]


