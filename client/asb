ENROLL_NAME_RE = re.compile(r"^[a-z0-9][a-z0-9_.-]{0,31}$")
CLIENT_SECRET_PREFIX = "asbc1_"


def enroll_hash(secret):
    """sha256 of the secret, domain separated. Must equal secret_broker.clients.hash_secret."""
    return hashlib.sha256(b"asb-client-secret-v1\0" + secret.encode()).hexdigest()


def enroll_code(secret_hash):
    """The confirmation code (XXXX-XXXX) both this terminal and the approval card show; derived
    from the hash. Must equal secret_broker.clients.confirm_code."""
    s = base64.b32encode(hashlib.sha256(b"asb-enroll-code-v1\0" + secret_hash.encode()).digest()).decode()[:8]
    return s[:4] + "-" + s[4:]


def _safe_text(text, n=160):
    """Server-supplied text shown on a terminal: printable ASCII only."""
    return "".join(c if 32 <= ord(c) < 127 else "?" for c in str(text))[:n]


_LONG_TOKEN = re.compile(r"[A-Za-z0-9_+/=.~-]{20,}")


def _srv(text, n=160):
    """Text the BROKER sent, for a terminal or a log: printable ASCII, and any long token-like run is
    replaced. The broker only ever sends fixed labels for a failed call (never an exception's text), so
    this is defence in depth: an old or misbehaving broker's error must not carry a credential into an
    agent's transcript. (The client holds no secret values and cannot mask them by value.)"""
    return _LONG_TOKEN.sub("***", _safe_text(text, 400))[:n]


def die(msg, code=EXIT_USAGE):
    print(f"asb: {msg}", file=sys.stderr)
    sys.exit(code)


def config():
    url, key = os.environ.get("SECRET_BROKER_URL"), os.environ.get("SECRET_BROKER_KEY")
    if not (url and key):
        try:
            with open(os.path.expanduser("~/.config/secret-broker/client.json")) as f:
                c = json.load(f)
            url, key = c["url"], c["key"]
        except (OSError, KeyError, json.JSONDecodeError):
            die("no broker config (set SECRET_BROKER_URL/KEY or ~/.config/secret-broker/client.json)")
    return url.rstrip("/"), key


USER_AGENT = "asb/1 (+https://github.com/rgregg/agent-secret-broker)"     # not urllib's default: Cloudflare blocks that


def call(base, key, path, body=None, timeout=40):
    req = urllib.request.Request(
        base + path, headers={"X-Client-Key": key, "Content-Type": "application/json", "User-Agent": USER_AGENT},
        data=json.dumps(body).encode() if body is not None else None)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, json.load(r)
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.load(e)
        except json.JSONDecodeError:
            return e.code, {"error": e.reason}
    except OSError as e:
        die(f"cannot reach broker: {e}", EXIT_BROKER)


def status_exit(status):
    return {"denied": EXIT_DENIED, "expired": EXIT_EXPIRED}.get(status, EXIT_BROKER)


def check_name(name, what="NAME"):
    if name.startswith("-"):
        die(f"{what} {name!r} looks like a flag, not a credential name "
            "(see `asb list`; `asb help` for usage)")
    return name


def session_die(r):
    """Exit for a broker answer that carries a session error code; returns normally if it has none."""
    c = r.get("code") if isinstance(r, dict) else None
    if c in ("session_unknown", "session_expired"):
        die(_srv(r.get("error") or "session ended"), EXIT_SESSION_ENDED)
    if c == "session_refused":
        die(_srv(r.get("error") or "session call refused"), EXIT_SESSION_REFUSED)


def obtain(payload, waiting="waiting for approval on your phone..."):
    base, key = config()
    payload["source"] = f"{os.environ.get('USER', '?')}@{socket.gethostname()}"
    code, r = call(base, key, "/v1/requests", payload)
    if code != 202:
        session_die(r)
        die(_srv(r.get("error", f"broker returned {code}")), EXIT_BROKER)
    if r["status"] in ("denied", "expired", "failed"):
        die(_srv(r.get("error") or r["status"]), status_exit(r["status"]))
    print(f"asb: {waiting}", file=sys.stderr)
    deadline = time.time() + r["expires_in"] + 15
    while time.time() < deadline:
        code, r2 = call(base, key, f"/v1/requests/{r['id']}?wait=25")
        if r2.get("status") == "approved":
            return r2
        if r2.get("status") in ("denied", "expired", "failed", "released"):
            die(f"request {r2['status']}" + (f": {_srv(r2['error'])}" if r2.get("error") else ""),
                status_exit(r2["status"]))
    die("timed out waiting for approval", EXIT_EXPIRED)


MAX_BODY = 5_000_000
MAX_GUIDANCE_BODY = 100 * 1024      # what the broker accepts for one proposal


def _guidance_entries(argv):
    """Entries from `propose` arguments: FILE|- (JSON list or {"entries": [...]}) or
    --from-dir DIR (NAME.txt files)."""
    if len(argv) == 2 and argv[0] == "--from-dir":
        try:
            files = sorted(f for f in os.listdir(argv[1]) if f.endswith(".txt")
                           and os.path.isfile(os.path.join(argv[1], f)))
        except OSError as e:
            die(f"cannot read {argv[1]}: {e}")
        entries = []
        for f in files:
            try:
                with open(os.path.join(argv[1], f), encoding="utf-8") as fh:
                    entries.append({"name": check_name(f[:-4]), "text": fh.read()})
            except (OSError, UnicodeDecodeError) as e:
                die(f"cannot read {f}: {e}")
        if not entries:
            die(f"no NAME.txt files in {argv[1]}")
        return entries
    if len(argv) != 1 or (argv[0].startswith("-") and argv[0] != "-"):
        die(HELP["guidance"])
    try:
        raw = sys.stdin.read() if argv[0] == "-" else open(argv[0], encoding="utf-8").read()
        data = json.loads(raw)
    except (OSError, ValueError) as e:
        die(f"cannot read the proposal: {e}")
    entries = data.get("entries") if isinstance(data, dict) else data
    if not isinstance(entries, list) or not entries:
        die('the proposal must be a list of {"name", "text"} or {"entries": [...]}')
    return entries


def _print_guidance(res):
    for k in ("applied", "denied", "failed"):
        print(f"{k}: {', '.join(res.get(k) or []) or '-'}")


def _guidance_exit(r):
    """Exit code for a finished proposal: 0 if something was applied."""
    if r.get("status") == "approved":
        return 0 if (r.get("guidance") or {}).get("applied") else EXIT_BROKER
    return status_exit(r.get("status"))


def run_guidance(argv):
    if len(argv) >= 1 and argv[0] == "status":
        if len(argv) != 2 or not re.fullmatch(r"[A-Za-z0-9_-]{8,64}", argv[1]):
            die(HELP["guidance"])
        base, key = config()
        code, r = call(base, key, f"/v1/requests/{argv[1]}?wait=0", timeout=15)
        if code != 200:
            die(_srv(r.get("error", f"broker returned {code}")), EXIT_BROKER)
        if r.get("status") not in ("approved", "denied", "expired", "failed"):
            print("pending")          # undecided, or being applied: not an error
            return 0
        _print_guidance(r.get("guidance") or {})
        return _guidance_exit(r)
    if not argv or argv[0] != "propose":
        die(HELP["guidance"])
    entries = _guidance_entries(argv[1:])
    payload = {"mode": "guidance", "entries": entries,
               "source": f"{os.environ.get('USER', '?')}@{socket.gethostname()}"}
    if len(json.dumps(payload).encode()) > MAX_GUIDANCE_BODY:
        die(f"the proposal is larger than {MAX_GUIDANCE_BODY} bytes")
    base, key = config()
    code, r = call(base, key, "/v1/requests", payload)
    if code != 202:
        die(_srv(r.get("error", f"broker returned {code}")), EXIT_BROKER)
    print(f"asb: proposal {r['id']} sent", file=sys.stderr)
    if r["status"] in ("denied", "expired", "failed"):
        die(_srv(r.get("error") or r["status"]), status_exit(r["status"]))
    print("asb: waiting for approval on your phone... review each entry on the approval page "
          "(the human ticks the ones to apply)", file=sys.stderr)
    deadline = time.time() + r["expires_in"] + 15
    while time.time() < deadline:
        code, r2 = call(base, key, f"/v1/requests/{r['id']}?wait=25")
        if r2.get("status") in ("approved", "denied", "expired", "failed"):
            _print_guidance(r2.get("guidance") or {})
            return _guidance_exit(r2)
    die("timed out waiting for approval", EXIT_EXPIRED)


CLIENT_JSON = os.path.join("~", ".config", "secret-broker", "client.json")


def _enroll_http(base, path, body=None):
    """(status, dict) from the unauthenticated enrollment endpoints. Network failures are
    reported by class only (never exception text); the secret is not involved."""
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(base + path, data=data, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return r.status, json.load(r)
    except urllib.error.HTTPError as e:
        try:
            out = json.load(e)
            return e.code, out if isinstance(out, dict) else {}
        except (ValueError, OSError):
            return e.code, {}
    except (OSError, ValueError) as e:
        return None, {"_net": type(e).__name__}


def _write_client_json(path, cfg):
    d = os.path.dirname(path)
    os.makedirs(d, mode=0o700, exist_ok=True)
    tmp = f"{path}.tmp{os.getpid()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")
    os.replace(tmp, path)


def run_enroll(argv):
    """asb enroll [--name NAME] [--url URL] [--force]"""
    name = url = None
    force = False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--force":
            force, i = True, i + 1
        elif a in ("--name", "--url") and i + 1 < len(argv):
            if a == "--name":
                name = argv[i + 1]
            else:
                url = argv[i + 1]
            i += 2
        else:
            die(f"unexpected argument {a!r}\n" + HELP["enroll"])
    path = os.path.expanduser(CLIENT_JSON)
    old = None
    try:
        with open(path) as f:
            old = json.load(f)
        if not isinstance(old, dict):
            old = None
    except (OSError, ValueError):
        old = None
    url = (url or os.environ.get("SECRET_BROKER_URL") or (old or {}).get("url") or "").rstrip("/")
    if not url.startswith(("http://", "https://")):
        die("no broker url: pass --url https://broker.example/ or set SECRET_BROKER_URL\n" + HELP["enroll"])
    if name is None:
        name = re.sub(r"[^a-z0-9_.-]+", "-", socket.gethostname().split(".")[0].lower()).strip("-.")[:32]
        name = name if ENROLL_NAME_RE.match(name or "") else "client"
    if not ENROLL_NAME_RE.match(name):
        die("--name must be 1-32 lowercase letters, digits, - _ . and start with a letter or digit")
    if (old or {}).get("key") and not force:
        die(f"{CLIENT_JSON} already holds a key; enrolling would replace it. Run with --force to do it "
            "(the old file is first copied to client.json.bak-<time>), or use another HOME.")
    secret = CLIENT_SECRET_PREFIX + base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip("=")
    h = enroll_hash(secret)
    code = enroll_code(h)
    claim = re.sub(r"[^A-Za-z0-9@._:+()\[\]-]", "_", f"{os.environ.get('USER', '?')}@{socket.gethostname()}")[:120]
    status, r = _enroll_http(url, "/v1/enroll", {"name": name, "hash": h, "claim": claim})
    if status is None:
        die(f"cannot reach the broker ({r.get('_net', 'error')})", EXIT_BROKER)
    if status != 202 or not isinstance(r.get("id"), str):
        die("the broker refused the enrollment: " + _srv(r.get("error") or f"HTTP {status}"), EXIT_BROKER)
    if r.get("code") != code:
        die("the broker returned a different confirmation code; not continuing", EXIT_BROKER)
    print(f"asb: enrollment requested as {name!r}.", file=sys.stderr)
    print(f"asb: confirmation code: {code}", file=sys.stderr)
    print("asb: waiting for the human to approve the card with this same code on the approval page "
          "(deny it if the code differs or you did not start this)...", file=sys.stderr)
    deadline = time.time() + int(r.get("expires_in") or 600) + 15
    errors = 0
    while time.time() < deadline:
        time.sleep(max(1, min(int(r.get("interval") or 2), 10)))
        st, p = _enroll_http(url, f"/v1/enroll/{urllib.parse.quote(r['id'], safe='')}")
        if st is None or st in (429, 500, 502, 503, 504):
            errors += 1
            if errors > 15:
                die("lost contact with the broker while waiting", EXIT_BROKER)
            continue
        errors = 0
        if st != 200:
            die("the broker no longer knows this enrollment", EXIT_BROKER)
        if p.get("status") == "denied":
            die("enrollment denied", EXIT_DENIED)
        if p.get("status") == "expired":
            die("enrollment expired before anyone approved it", EXIT_EXPIRED)
        if p.get("status") == "approved":
            break
    else:
        die("timed out waiting for approval", EXIT_EXPIRED)
    backup = None
    if old is not None:
        backup = f"{path}.bak-{time.strftime('%Y%m%d%H%M%S')}"
        fd = os.open(backup, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(old, f, indent=2)
            f.write("\n")
    new = dict(old or {})
    new["url"], new["key"] = url, secret
    _write_client_json(path, new)
    # prove the new credential works before calling this done; otherwise put the old file back
    req = urllib.request.Request(url + "/v1/status", headers={"X-Client-Key": secret})
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            ok = resp.status == 200
    except (urllib.error.URLError, OSError, ValueError):
        ok = False
    if not ok:
        if backup:
            shutil.copyfile(backup, path)
            os.chmod(path, 0o600)
        else:
            os.unlink(path)
        die("the broker approved the enrollment but rejected the new key; client.json was not changed", EXIT_BROKER)
    print(f"enrolled: {_safe_text(p.get('name') or name, 40)} ({_safe_text(p.get('client_id') or '?', 16)})")
    print(f"asb: wrote {CLIENT_JSON}" + (f" (the previous file is saved as {os.path.basename(backup)})" if backup else "")
          + ". Nothing was printed that you need to keep.", file=sys.stderr)
    if os.environ.get("SECRET_BROKER_KEY"):
        print("asb: the SECRET_BROKER_KEY environment variable is set and overrides client.json; unset it "
              "to use this machine's own credential.", file=sys.stderr)
    return 0


def run_request_credential(argv):
    """asb request-credential NAME --kind token|login --for TEXT [--host H]... [--var V] [--mode M].
    Nothing secret is read or sent: the human types the value on the approval page."""
    if not argv:
        die(HELP["request-credential"])
    name, rest = check_name(argv[0]), argv[1:]
    opts, hosts, i = {}, [], 0
    while i < len(rest):
        k = rest[i]
        if k not in ("--kind", "--for", "--host", "--var", "--mode") or i + 1 >= len(rest):
            die(f"unexpected argument {k!r}\n" + HELP["request-credential"])
        v = rest[i + 1]
        if k == "--host":
            hosts += [h for h in v.split(",") if h]
        elif k in opts:
            die(f"{k} given twice")
        else:
            opts[k] = v
        i += 2
    if opts.get("--kind") not in ("token", "login"):
        die("--kind must be token or login\n" + HELP["request-credential"])
    if not opts.get("--for", "").strip():
        die('--for "what it is for" is required\n' + HELP["request-credential"])
    if len(opts["--for"]) > 300:
        die("--for is limited to 300 characters")
    mode = opts.get("--mode", "http")
    if mode not in ("http", "env"):
        die("--mode must be http or env")
    if mode == "http" and not hosts:
        die("--mode http needs at least one --host (use --mode env for a credential with no host)\n"
            + HELP["request-credential"])
    payload = {"mode": "credential", "names": [name], "kind": opts["--kind"], "purpose": opts["--for"],
               "hosts": hosts, "cred_mode": mode}
    if opts.get("--var"):
        payload["var"] = opts["--var"]
    r = obtain(payload, "waiting for the human to enter the credential on the approval page "
                        "(you will not see the value)...")["stored"]
    print(f"stored: {r['name']}")
    print("asb: see `asb list` for its variables and hosts", file=sys.stderr)
    return 0


SESSION_ID_RE = re.compile(r"^[A-Za-z0-9_-]{32}\Z")
CAPTURE_NAME_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_]{0,31}\Z")
SESSION_METHODS = ("GET", "HEAD", "OPTIONS", "POST", "PUT", "PATCH", "DELETE")


def check_capture(text):
    """Validate a --capture expression locally (the broker checks again): NAME=header:X | cookie:NAME |
    json:$.a.b[0] (dotted keys and array indexes only). Anything else is a usage error."""
    name, _, expr = text.partition("=")
    kind, _, arg = expr.partition(":")
    ok = bool(CAPTURE_NAME_RE.match(name))
    if kind == "header":
        ok = ok and bool(re.fullmatch(r"[A-Za-z0-9-]{1,64}", arg))
    elif kind == "cookie":
        ok = ok and bool(re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", arg))
    elif kind == "json":
        ok = ok and bool(re.fullmatch(r"\$(\.[A-Za-z0-9_-]{1,64}|\[[0-9]{1,4}\]){1,12}", arg))
    else:
        ok = False
    if not ok:
        die("bad --capture: use NAME=header:X-CSRF-Token, NAME=cookie:NAME or NAME=json:$.a.b[0] "
            "(only dotted keys and array indexes)")
    return text


def parse_ttl(text):
    m = re.fullmatch(r"([0-9]{1,6})([smh])", text or "")
    if not m:
        die("--ttl must be a number with a unit: 90s, 15m or 1h")
    return int(m.group(1)) * {"s": 1, "m": 60, "h": 3600}[m.group(2)]


def run_session(argv):
    """asb session open|close|status. Nothing secret is read or sent."""
    if not argv or argv[0] not in ("open", "close", "status"):
        die(HELP["session"])
    sub, rest = argv[0], argv[1:]
    if sub in ("close", "status"):
        if len(rest) != 1 or not SESSION_ID_RE.match(rest[0]):
            die("usage: asb session " + sub + " ID\n" + HELP["session"])
        base, key = config()
        if sub == "close":
            code, r = call(base, key, "/v1/requests", {"mode": "session_close", "session": rest[0]})
            if code == 200:
                print("closed")
                return 0
        else:
            code, r = call(base, key, "/v1/sessions/" + rest[0], timeout=15)
            if code == 200:
                print(f"time left: {r['expires_in']}s, calls left: {r['calls_left']} of {r['max_calls']}")
                print(f"hosts: {','.join(r['hosts'])}  methods: {','.join(r['methods'])}")
                return 0
        session_die(r)
        die(_srv(r.get("error", f"broker returned {code}")), EXIT_BROKER)
    if not rest:
        die(HELP["session"])
    name, rest = check_name(rest[0]), rest[1:]
    opts, hosts, i = {}, [], 0
    while i < len(rest):
        k = rest[i]
        if k not in ("--for", "--host", "--methods", "--ttl", "--max-calls") or i + 1 >= len(rest):
            die(f"unexpected argument {k!r}\n" + HELP["session"])
        v = rest[i + 1]
        if k == "--host":
            hosts += [h for h in v.split(",") if h]
        elif k in opts:
            die(f"{k} given twice")
        else:
            opts[k] = v
        i += 2
    if not opts.get("--for", "").strip():
        die('--for "what it is for" is required\n' + HELP["session"])
    if len(opts["--for"]) > 300:
        die("--for is limited to 300 characters")
    if not hosts:
        die("at least one --host is required (a session is limited to specific hosts)\n" + HELP["session"])
    payload = {"mode": "session", "names": [name], "purpose": opts["--for"], "hosts": hosts}
    if "--methods" in opts:
        ms = [m.strip().upper() for m in opts["--methods"].split(",") if m.strip()]
        if not ms or any(m not in SESSION_METHODS for m in ms):
            die("--methods must be some of " + ",".join(SESSION_METHODS))
        payload["methods"] = ms
    if "--ttl" in opts:
        payload["ttl_s"] = parse_ttl(opts["--ttl"])
    if "--max-calls" in opts:
        if not (opts["--max-calls"].isascii() and opts["--max-calls"].isdigit()) or not 1 <= int(opts["--max-calls"]) <= 100000:
            die("--max-calls must be a whole number of at least 1")
        payload["max_calls"] = int(opts["--max-calls"])
    s = obtain(payload, "waiting for the human to approve the session...")["session"]
    print(s["id"])
    print(f"asb: session open for {s['expires_in']}s (fixed: no extension or renewal), up to {s['max_calls']} calls, "
          f"hosts {','.join(s['hosts'])}, methods {','.join(s['methods'])}", file=sys.stderr)
    return 0


WS_ID_ENV = "ASB_WS_SESSION"
WS_MAX_SEND = 4 << 20


def ws_rc(code, r):
    """(exit code, message) for a broker answer that is not a success."""
    c = r.get("code") if isinstance(r, dict) else None
    msg = _srv((r.get("error") if isinstance(r, dict) else None) or f"broker returned {code}")
    if c in ("session_unknown", "session_expired"):
        return EXIT_SESSION_ENDED, msg
    if c == "session_refused":
        return EXIT_SESSION_REFUSED, msg
    return EXIT_BROKER, msg


def ws_post(base, key, path, body, timeout=40):
    code, r = call(base, key, path, body, timeout)
    if code != 200:
        rc, msg = ws_rc(code, r)
        die(msg, rc)
    return r


_WS_BAD = re.compile("[\x00-\x08\x0b-\x1f\x7f-\x9f\u061c\u200e\u200f\u202a-\u202e\u2066-\u2069]")


def ws_clean(text):
    """Server text for a terminal: newlines become spaces (one frame, one line); other control characters and the
    bidirectional override characters (which can make text read differently from what it is) are removed."""
    return _WS_BAD.sub("", str(text).replace("\r", " ").replace("\n", " "))


def ws_print(frames):
    """Text frames to stdout, one per line; a binary marker to stderr."""
    for f in frames:
        if f.get("type") == "text":
            sys.stdout.write(ws_clean(f.get("data", "")) + "\n")
        else:
            print(f"asb: binary frame ({int(f.get('bytes', 0))} bytes) not shown", file=sys.stderr)
    sys.stdout.flush()


def ws_notes(r):
    if r.get("truncated"):
        print("asb: the broker's receive buffer filled and it paused reading (nothing was dropped); "
              "collect frames more often", file=sys.stderr)


def ws_session_id(pos, need_more):
    """(session id, remaining positionals): the first positional when it is an id and there are `need_more`
    more after it, else $ASB_WS_SESSION."""
    if pos and len(pos) > need_more and SESSION_ID_RE.match(pos[0]):
        return pos[0], pos[1:]
    env = os.environ.get(WS_ID_ENV, "").strip()
    if env:
        if not SESSION_ID_RE.match(env):
            die(f"{WS_ID_ENV} is not a session id (the one `asb ws NAME URL` printed)")
        return env, pos
    die("a session id is needed (the one `asb ws NAME URL` printed, or export " + WS_ID_ENV + "=ID)\n" + HELP["ws"])


def ws_flags(argv, allowed, bools=()):
    """(positionals, flags). Flags take a value unless listed in `bools`."""
    pos, flags, i = [], {}, 0
    while i < len(argv):
        a = argv[i]
        if a in bools:
            flags[a] = True
            i += 1
        elif a in allowed:
            if i + 1 >= len(argv):
                die(f"{a} needs a value\n" + HELP["ws"])
            if a in flags:
                die(f"{a} given twice")
            flags[a] = argv[i + 1]
            i += 2
        elif a.startswith("-") and a != "-" and not SESSION_ID_RE.match(a):     # (an id may start with "-")
            die(f"unexpected argument {a!r}\n" + HELP["ws"])
        else:
            pos.append(a)
            i += 1
    return pos, flags


def ws_number(text, what, lo, hi, integer=False):
    try:
        v = float(text) if not integer else (int(text) if text.isascii() and text.isdigit() else None)
    except ValueError:
        v = None
    if v is None or v != v or not lo <= v <= hi:
        die(f"{what} must be a number from {lo} to {hi}")
    return v


def run_ws(argv):
    """asb ws: open, send, recv, close, pipe. The credential never reaches this process."""
    if not argv:
        die(HELP["ws"])
    sub = argv[0]
    if sub == "send":
        pos, _ = ws_flags(argv[1:], ())
        sid, rest = ws_session_id(pos, 1)
        if len(rest) != 1:
            die("usage: asb ws send [ID] TEXT|-\n" + HELP["ws"])
        text = sys.stdin.read() if rest[0] == "-" else rest[0]
        if rest[0] == "-" and text.endswith("\n"):
            text = text[:-1]
        if len(text.encode("utf-8", "replace")) > WS_MAX_SEND:
            die("a frame is limited to 4 MB")
        base, key = config()
        r = ws_post(base, key, "/v1/ws/send", {"session": sid, "text": text})
        print(f"sent ({r.get('frames_left')} frames left, {r.get('expires_in')}s left)", file=sys.stderr)
        return 0
    if sub == "recv":
        pos, fl = ws_flags(argv[1:], ("--wait", "--max"), ("--json",))
        sid, rest = ws_session_id(pos, 0)
        if rest:
            die("usage: asb ws recv [ID] [--wait S] [--max N] [--json]\n" + HELP["ws"])
        wait = ws_number(fl.get("--wait", "0"), "--wait", 0, 25)
        mx = ws_number(fl.get("--max", "256"), "--max", 1, 256, integer=True)
        base, key = config()
        r = ws_post(base, key, "/v1/ws/recv", {"session": sid, "wait": wait, "max": int(mx)}, timeout=int(wait) + 20)
        if "--json" in fl:
            print(json.dumps(r))
            return 0
        ws_print(r.get("frames") or [])
        ws_notes(r)
        if r.get("queued"):
            print(f"asb: {r['queued']} more frames waiting", file=sys.stderr)
        if r.get("closed"):
            print("asb: the connection is closed (" + _srv(r.get("close_reason") or "closed") + ")", file=sys.stderr)
            return 0 if r.get("frames") else EXIT_SESSION_ENDED
        return 0
    if sub == "close":
        pos, _ = ws_flags(argv[1:], ())
        sid, rest = ws_session_id(pos, 0)
        if rest:
            die("usage: asb ws close [ID]\n" + HELP["ws"])
        base, key = config()
        code, r = call(base, key, "/v1/requests", {"mode": "session_close", "session": sid})
        if code == 200:
            print("closed")
            return 0
        rc, msg = ws_rc(code, r)
        die(msg, rc)
    pos, fl = ws_flags(argv, ("--ttl", "--max-frames", "--linger"), ("--close",))
    if len(pos) == 2 and not ({"--linger", "--close"} & set(fl)):
        return ws_open(pos[0], pos[1], fl)
    if len(pos) > 1 or ({"--ttl", "--max-frames"} & set(fl)):
        die("usage: asb ws NAME URL [--ttl 15m] [--max-frames N]  |  asb ws [ID] [--linger S] [--close]\n" + HELP["ws"])
    sid, _ = ws_session_id(pos, 0)
    return ws_pipe(sid, ws_number(fl.get("--linger", "2"), "--linger", 0, 300), "--close" in fl)


def ws_open(name, url, fl):
    check_name(name)
    if not re.match(r"^wss?://", url or "") or len(url) > 2048:
        die("URL must be ws://host[:port]/path or wss://host[:port]/path\n" + HELP["ws"])
    payload = {"mode": "session", "kind": "ws", "names": [name], "url": url}
    if "--ttl" in fl:
        t = fl["--ttl"]
        payload["ttl_s"] = int(t) if t.isascii() and t.isdigit() and len(t) <= 6 else parse_ttl(t)
    if "--max-frames" in fl:
        payload["max_frames"] = int(ws_number(fl["--max-frames"], "--max-frames", 1, 100000, integer=True))
    s = obtain(payload, "waiting for the human to approve the WebSocket session...")["session"]
    print(s["id"])
    print(f"asb: WebSocket session open for {s['expires_in']}s (fixed: no extension or renewal), up to "
          f"{s.get('max_frames', s['max_calls'])} frames each way, {s['hosts'][0]}; "
          f"export {WS_ID_ENV}=ID to leave the id off the other commands", file=sys.stderr)
    return 0


def ws_pipe(sid, linger, close_at_end):
    """Line relay: every stdin line is one text frame to the server; every text frame from the server is one
    stdout line. Leaves after `linger` seconds without a frame in either direction once stdin has ended, or when
    the server closes the connection."""
    import threading
    base, key = config()
    st = {"rc": 0, "msg": None, "done": False, "last": time.monotonic(), "stop": False}

    def writer():
        try:
            for line in sys.stdin:
                line = line.rstrip("\r\n")
                if not line:
                    continue
                if st["stop"]:
                    return
                code, r = call(base, key, "/v1/ws/send", {"session": sid, "text": line})
                st["last"] = time.monotonic()
                if code != 200:
                    st["rc"], st["msg"] = ws_rc(code, r)
                    st["stop"] = True
                    return
        except SystemExit as e:                     # `call` died: the broker is unreachable
            st["rc"], st["stop"] = (e.code if isinstance(e.code, int) else EXIT_BROKER), True
        finally:
            st["done"] = True
            st["last"] = time.monotonic()
    threading.Thread(target=writer, daemon=True).start()
    while not st["stop"]:
        left = linger - (time.monotonic() - st["last"]) if st["done"] else 10
        if st["done"] and left <= 0:
            break
        code, r = call(base, key, "/v1/ws/recv", {"session": sid, "wait": max(0.2, min(10, left)) if st["done"] else 10, "max": 256}, 40)
        if code != 200:
            rc, msg = ws_rc(code, r)
            die(msg, rc)
        if r.get("frames"):
            st["last"] = time.monotonic()
        ws_print(r.get("frames") or [])
        ws_notes(r)
        if r.get("closed"):
            print("asb: the connection is closed (" + _srv(r.get("close_reason") or "closed") + ")", file=sys.stderr)
            return 0 if r.get("frames") or st["rc"] == 0 else st["rc"]
    if st["msg"]:
        print("asb: " + st["msg"], file=sys.stderr)
    if close_at_end and not st["rc"]:
        call(base, key, "/v1/requests", {"mode": "session_close", "session": sid})
    return st["rc"]


def read_body(arg):
    """-d BODY | -d @file | -d @- (stdin). Returns payload fields for the broker.

    UTF-8 content is sent as text so {{VAR}} placeholders are substituted;
    anything else is sent as base64 and passed through untouched.
    """
    if not arg.startswith("@"):
        return {"body": arg}
    try:
        raw = sys.stdin.buffer.read() if arg == "@-" else open(arg[1:], "rb").read()
    except OSError as e:
        die(f"cannot read body: {e}")
    if len(raw) > MAX_BODY:
        die(f"body is {len(raw)} bytes; limit is {MAX_BODY}")
    try:
        return {"body": raw.decode("utf-8")}
    except UnicodeDecodeError:
        return {"body_b64": base64.b64encode(raw).decode()}


def read_value():
    """The credential value: stdin (pipe) or a hidden prompt on a terminal. It is
    never accepted as an argument, so it cannot end up in shell history or ps."""
    if sys.stdin.isatty():
        import getpass
        v = getpass.getpass("value (hidden): ")
    else:
        v = sys.stdin.read()
    v = v.rstrip("\r\n")
    if not v:
        die("no value on stdin")
    return v


def parse_flags(argv, allowed):
    out, i = {}, 0
    while i < len(argv):
        k = argv[i]
        if k not in allowed or i + 1 >= len(argv):
            die(f"unexpected argument {k!r}")
        out[allowed[k]] = argv[i + 1]
        i += 2
    return out


# -- ssh-agent protocol (draft-miller-ssh-agent) ------------------------------
AGENT_FAILURE, AGENTC_REQUEST_IDENTITIES, AGENT_IDENTITIES_ANSWER = 5, 11, 12
AGENTC_SIGN_REQUEST, AGENT_SIGN_RESPONSE = 13, 14
AGENT_SUCCESS, AGENTC_EXTENSION = 6, 27
BIND_EXT = b"session-bind@openssh.com"
MAX_BINDS = 16              # per agent connection


def _strings(b, n):
    """n length-prefixed strings from the front of b, then whatever is left."""
    out = []
    for _ in range(n):
        ln = int.from_bytes(b[:4], "big")
        if len(b) < 4 + ln:
            raise ValueError("short string")
        out.append(b[4:4 + ln])
        b = b[4 + ln:]
    return out, b


# -- claimed destination: what the wrapped command line says it connects to ----
# Unverified by construction (ssh_config can rename hosts, a script can do
# anything); the broker shows it as "claimed by the client".
_SSH_VAL = set("BbcDEeFIiJLlmOopQRSWw")             # ssh options that take an argument
_SCP_VAL = set("cDFiJloPS")
_SFTP_VAL = set("BbcDFiJloPRSs")
_HOST_RE = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9._-]*$|^[0-9A-Fa-f:.]*:[0-9A-Fa-f:.]*$")
_USER_RE = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9._-]*$")


def _walk(args, val_opts):
    """Split ssh-style args into ([(opt char, value)], operands). Stops at the
    first operand when val_opts is for ssh (the rest is the remote command)."""
    opts, ops, i = [], [], 0
    while i < len(args):
        a = args[i]
        i += 1
        if a == "--":
            ops += args[i:]
            break
        if a.startswith("-") and len(a) > 1:
            j = 1
            while j < len(a):
                c = a[j]
                if c in val_opts:
                    v = a[j + 1:] or (args[i] if i < len(args) else "")
                    if not a[j + 1:]:
                        i += 1
                    opts.append((c, v))
                    break
                j += 1
            continue
        ops.append(a)
    return opts, ops


def _o_pairs(opts):
    """-o Key=Value / -o 'Key Value' -> {lower key: value} (first wins, like ssh)."""
    out = {}
    for c, v in opts:
        if c == "o":
            k, _, val = v.replace("=", " ", 1).partition(" ")
            out.setdefault(k.strip().lower(), val.strip())
    return out


def _fmt(user, host, port, jump=None):
    if not host or not _HOST_RE.match(host) or (user and not _USER_RE.match(user)):
        return None
    try:
        port = int(port)
    except (TypeError, ValueError):
        return None
    if not 0 < port < 65536:
        return None
    h = f"[{host}]" if ":" in host else host
    out = (f"{user}@" if user else "") + f"{h}:{port}"
    if jump:
        out += f" (via {jump})"
    return out[:200]


def _split_target(t):
    """[user@]host | ssh://[user@]host[:port][/..] -> (user, host, port|None)."""
    user = port = None
    url = t.startswith(("ssh://", "scp://", "sftp://"))
    if url:
        t = t.split("://", 1)[1].split("/", 1)[0]
    if "@" in t:
        user, _, t = t.rpartition("@")
    if t.startswith("["):
        host, _, rest = t[1:].partition("]")
        if rest.startswith(":") and rest[1:]:
            port = rest[1:]
    elif url and t.count(":") == 1:
        host, _, port = t.partition(":")
    else:
        host = t
    return user or None, host, port


def _jump_note(jump):
    hops = [h for h in (jump or "").split(",") if h]
    if not hops or not all(re.fullmatch(r"[A-Za-z0-9@._:\[\]%-]+", h) for h in hops):
        return None
    return hops[0] + (f"+{len(hops) - 1}" if len(hops) > 1 else "")


def _build(user, host, port, opts, jump_opt=None):
    o = _o_pairs(opts)
    host = o.get("hostname") or host
    user = user or o.get("user")
    port = port or o.get("port") or "22"
    return _fmt(user, host, port, _jump_note(jump_opt or o.get("proxyjump")))


def _first(opts):
    d = {}
    for c, v in opts:
        d.setdefault(c, v)
    return d


def _ssh_claim(args):
    """ssh [options] [user@]host [command]: the first operand is the destination."""
    opts, i = [], 0
    while i < len(args):
        a = args[i]
        i += 1
        if a == "--":
            break
        if not (a.startswith("-") and len(a) > 1):
            i -= 1
            break
        for j in range(1, len(a)):
            if a[j] in _SSH_VAL:
                if a[j + 1:]:
                    opts.append((a[j], a[j + 1:]))
                elif i < len(args):
                    opts.append((a[j], args[i]))
                    i += 1
                break
    if i >= len(args):
        return None
    user, host, port = _split_target(args[i])
    d = _first(opts)
    return _build(user or d.get("l"), host, port or d.get("p"), opts, d.get("J"))


def _rsync_args(args):
    """-> (remote shell command string, operands) for an rsync command line."""
    rsh, ops, i = "ssh", [], 0
    while i < len(args):
        a = args[i]
        i += 1
        if a.startswith("--rsh="):
            rsh = a[6:]
        elif a == "--rsh" and i < len(args):
            rsh, i = args[i], i + 1
        elif a.startswith("-") and not a.startswith("--") and a.endswith("e") and i < len(args):
            rsh, i = args[i], i + 1                 # -e CMD, or a cluster ending in e (-ae CMD)
        elif not a.startswith("-"):
            ops.append(a)
    return rsh, ops


def _remote_operand(a):
    """`[user@]host:path` / `scp://...` operand of scp, sftp or rsync -> (user, host, port) or None."""
    if a.startswith(("scp://", "sftp://", "ssh://")):
        t = _split_target(a)
        return t if t[1] else None
    if a.startswith(("rsync://", "-", "/", ".", "~")):
        return None
    head = a.split("/", 1)[0]
    if "@" in head:
        user, _, rest = a.partition("@")
    else:
        user, rest = None, a
    if rest.startswith("["):
        host, _, after = rest[1:].partition("]")
        return (user, host, None) if after.startswith(":") else None
    if "::" in rest.split("/", 1)[0]:
        return None                         # host::module is an rsync daemon, not ssh
    host, sep, _path = rest.partition(":")
    return (user, host, None) if sep and "/" not in host else None


def claimed_destination(argv):
    """The `user@host:port` the command line says it will connect to, or None
    when that cannot be told confidently. Never runs anything."""
    try:
        if not argv:
            return None
        prog, args = os.path.basename(argv[0]), list(argv[1:])
        if prog == "ssh":
            return _ssh_claim(args)
        if prog in ("scp", "sftp", "rsync"):
            val = _SCP_VAL if prog == "scp" else _SFTP_VAL if prog == "sftp" else set()
            if prog == "rsync":
                rsh, ops = _rsync_args(args)
                words = shlex.split(rsh)
                if not words or os.path.basename(words[0]) != "ssh":
                    return None
                sopts = _walk(words[1:], _SSH_VAL)[0]
            else:
                opts, ops = _walk(args, val)
                sopts = [("p" if c == "P" else c, v) for c, v in opts]
            if prog == "sftp":
                ops = ops[:1]
                targets = {_remote_operand(ops[0]) or _split_target(ops[0])} if ops else set()
            else:
                targets = {t for t in map(_remote_operand, ops) if t}
            if len(targets) != 1:
                return None             # nothing remote, or several different hosts
            (user, host, port), = targets
            d = _first(sopts)
            return _build(user or d.get("l"), host, port or d.get("p"), sopts, d.get("J"))
        if prog == "git":
            cands = set()
            for a in args:
                if a.startswith("ssh://"):
                    cands.add(_split_target(a))
                elif "@" in a.split(":", 1)[0] and not a.startswith(("-", "/", ".")):
                    t = _remote_operand(a)      # git@host:org/repo (user@ required: refspecs have colons)
                    if t:
                        cands.add(t)
            if len(cands) != 1:
                return None
            (user, host, port), = cands
            return _fmt(user, host, port or "22")
    except (ValueError, IndexError):
        return None
    return None


def _s(b):
    return len(b).to_bytes(4, "big") + b


def _read_msg(conn):
    def exact(n):
        buf = b""
        while len(buf) < n:
            chunk = conn.recv(n - len(buf))
            if not chunk:
                return None
            buf += chunk
        return buf
    head = exact(4)
    if head is None:
        return None
    n = int.from_bytes(head, "big")
    return exact(n) if 0 < n <= 1_000_000 else None


def _ssh_identities():
    base, key = config()
    code, r = call(base, key, "/v1/secrets")
    if code != 200:
        return []
    out = []
    for s in r["secrets"]:
        if s.get("ssh_public_key"):
            try:
                out.append((s["name"], base64.b64decode(s["ssh_public_key"].split()[1])))
            except (IndexError, ValueError):
                pass
    return out


def agent_reply(msg, conn=None):
    """Answer one ssh-agent request. Anything unsupported is a plain failure.

    `conn` is the per-connection state of a served agent ({"binds": [...],
    "claim": str|None}); without it session binding cannot be remembered, so
    that extension is refused like any other."""
    fail = bytes([AGENT_FAILURE])
    try:
        kind, body = msg[0], msg[1:]
        if kind == AGENTC_EXTENSION:
            (name,), rest = _strings(body, 1)
            if name != BIND_EXT or conn is None:
                return fail                 # OpenSSH carries on without the extension
            if len(conn["binds"]) >= MAX_BINDS:
                conn["overflow"] = True     # the broker then treats the whole chain as invalid
                return fail
            (hostkey, sid, sig), rest = _strings(rest, 3)
            if len(rest) != 1 or rest[0] > 1:
                return fail
            # The broker verifies the signature; the agent only remembers the bind.
            conn["binds"].append({"hostkey_b64": base64.b64encode(hostkey).decode(),
                                  "session_id_b64": base64.b64encode(sid).decode(),
                                  "sig_b64": base64.b64encode(sig).decode(),
                                  "forwarding": rest[0] == 1})
            return bytes([AGENT_SUCCESS])
        if kind == AGENTC_REQUEST_IDENTITIES:
            ids = _ssh_identities()
            return (bytes([AGENT_IDENTITIES_ANSWER]) + len(ids).to_bytes(4, "big")
                    + b"".join(_s(blob) + _s(f"broker:{name}".encode()) for name, blob in ids))
        if kind == AGENTC_SIGN_REQUEST:
            n = int.from_bytes(body[:4], "big")
            blob, rest = body[4:4 + n], body[4 + n:]
            m = int.from_bytes(rest[:4], "big")
            data, flags = rest[4:4 + m], int.from_bytes(rest[4 + m:8 + m], "big")
            name = next((nm for nm, b in _ssh_identities() if b == blob), None)
            if name is None:
                return fail
            req = {"mode": "ssh_sign", "names": [name], "flags": flags,
                   "data_b64": base64.b64encode(data).decode()}
            if conn and conn["binds"]:
                req["binds"] = conn["binds"]
            if conn and conn.get("overflow"):
                req["bind_overflow"] = True
            if conn and conn.get("claim"):
                req["claimed_dest"] = conn["claim"]
            r = obtain(req)
            return bytes([AGENT_SIGN_RESPONSE]) + _s(base64.b64decode(r["ssh_signature"]))
    except SystemExit:          # obtain() reported a denial/timeout on stderr
        return fail
    except (IndexError, ValueError, KeyError):
        return fail
    return fail


def serve_agent(path, claim=None):
    import socketserver

    class Handler(socketserver.BaseRequestHandler):
        def handle(self):
            conn = {"binds": [], "claim": claim}
            while True:
                msg = _read_msg(self.request)
                if msg is None:
                    return
                self.request.sendall(_s(agent_reply(msg, conn)))

    class Server(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
        daemon_threads = True

    return Server(path, Handler)


def run_ssh_agent(cmd, socket_path=None):
    import shutil
    import signal
    import tempfile
    import threading
    if socket_path:
        # A fixed, long-lived socket (a systemd user service, say). The directory
        # must already exist and be ours alone; a stale socket from a dead agent is
        # replaced, a live one is an error.
        path = os.path.abspath(os.path.expanduser(socket_path))
        parent = os.path.dirname(path)
        st = os.stat(parent) if os.path.isdir(parent) else die(f"{parent} is not a directory")
        if st.st_uid != os.getuid() or st.st_mode & 0o022:
            die(f"{parent} must be owned by you and not writable by others")
        if os.path.lexists(path):
            import stat
            if not stat.S_ISSOCK(os.lstat(path).st_mode):
                die(f"{path} exists and is not a socket; not replacing it")
            probe = socket.socket(socket.AF_UNIX)
            try:
                probe.connect(path)
            except OSError:
                os.unlink(path)
            else:
                die(f"an agent is already listening on {path}")
            finally:
                probe.close()
        d = None
    else:
        d = tempfile.mkdtemp(prefix="asb-agent-")    # 0700: only this user can reach the socket
        path = os.path.join(d, "agent.sock")
    old_umask = os.umask(0o177)
    try:
        srv = serve_agent(path, claimed_destination(cmd) if cmd else None)
    finally:
        os.umask(old_umask)
    os.chmod(path, 0o600)

    def on_term(*_):
        raise SystemExit(0)                          # a clean stop for systemd; finally still runs
    signal.signal(signal.SIGTERM, on_term)
    try:
        if socket_path and not cmd:
            print(f"asb: ssh-agent listening on {path}", file=sys.stderr)
            srv.serve_forever()
            return 0
        if not cmd:
            print(f"SSH_AUTH_SOCK={path}; export SSH_AUTH_SOCK;")
            sys.stdout.flush()
            srv.serve_forever()
            return 0
        threading.Thread(target=srv.serve_forever, daemon=True).start()
        return subprocess.run(cmd, env={**os.environ, "SSH_AUTH_SOCK": path}).returncode
    except KeyboardInterrupt:
        return 130
    finally:
        srv.server_close()
        if d:
            shutil.rmtree(d, ignore_errors=True)
        elif os.path.lexists(path):
            os.unlink(path)


AUDIT_FLAGS = {"--request": "request", "--event": "event", "--secret": "secret", "--since": "since",
               "--until": "until", "--source": "source", "--limit": "limit", "--before": "before",
               "--after": "after"}
AUDIT_SKIP = ("seq", "ts", "event", "request")


def audit_line(ev):
    """One human line: time, event, short request id, then the event's fields."""
    parts = []
    for k, v in ev.items():
        if k in AUDIT_SKIP or v is None:
            continue
        if isinstance(v, list):
            v = ",".join(str(x) for x in v)
        elif isinstance(v, bool):
            v = "yes" if v else "no"
        parts.append(f"{k}={v}")
    return f"{ev['ts'][:19]}Z  {ev['event']:<16} {(ev.get('request') or '-')[:8]:<8}  " + " ".join(parts)


def audit_get(base, key, path):
    code, r = call(base, key, path, timeout=30)
    if code == 400:
        die(_srv(r.get("error", "bad request")), EXIT_USAGE)
    if code != 200:
        die(_srv(r.get("error", f"broker returned {code}")), EXIT_BROKER)
    return r


def run_audit(argv):
    if argv[:1] == ["verify"]:
        if argv[1:]:
            die(HELP["audit"])
        base, key = config()
        r = audit_get(base, key, "/v1/audit/verify")
        if r["ok"]:
            print(f"audit log ok: {r['events']} events, hash chain intact")
            return 0
        print(f"audit log BROKEN: chain fails at seq {r['first_bad_seq']} "
              f"({r['events']} events checked)", file=sys.stderr)
        return EXIT_NOT_FOUND
    flags, as_json, tail, i = {}, False, False, 0
    while i < len(argv):
        a = argv[i]
        if a == "--json":
            as_json = True
        elif a == "--tail":
            tail = True
        elif a in AUDIT_FLAGS and i + 1 < len(argv):
            flags[AUDIT_FLAGS[a]] = argv[i + 1]
            i += 1
        else:
            die(f"unexpected argument {a!r}\n" + HELP["audit"])
        i += 1
    if tail and ("request" in flags or "before" in flags or "after" in flags):
        die("--tail follows the whole log; combine it with --event/--secret/--source only")
    base, key = config()
    qs = lambda extra: "/v1/audit?" + urllib.parse.urlencode({**flags, **extra})  # noqa: E731
    if not tail:
        r = audit_get(base, key, qs({}))
        if as_json:
            print(json.dumps(r, indent=2))
        else:
            evs = r["events"] if flags.get("request") or "after" in flags else r["events"][::-1]
            for ev in evs:
                print(audit_line(ev))
            if r["truncated"] or r["next"] is not None:
                arrow = "--after" if "after" in flags or flags.get("request") else "--before"
                print(f"asb: more events available; continue with {arrow} {r['next']}"
                      if r["next"] is not None else "asb: older history is not indexed",
                      file=sys.stderr)
        return 0 if r["events"] else EXIT_NOT_FOUND
    flags.setdefault("limit", "20")
    last = None
    try:
        while True:
            if last is None:
                r = audit_get(base, key, qs({}))
                evs = r["events"][::-1]
            else:
                r = audit_get(base, key, qs({"after": last, "order": "asc", "limit": "500"}))
                evs = r["events"]
            for ev in evs:
                print(json.dumps(ev) if as_json else audit_line(ev), flush=True)
                last = ev["seq"]
            time.sleep(2)
    except KeyboardInterrupt:
        return 0


