#!/usr/bin/env python3
"""secret-run: ask the broker for a secret, wait for phone approval, use it.

  secret-run NAME[,NAME2] -- command args...      run with secrets in the env
  secret-run list [--json]                        what credentials exist? (no approval)
  secret-run store NAME --hosts H[,H] [--field F] [--item I] [--var V]   < value
  secret-run update NAME [--var V]                                      < value
  secret-run which HOST|URL                       is a credential available? (no approval)
  secret-run fingerprint HOST[:PORT]              print a server certificate's sha256 (for tls_fingerprint)
  secret-run http NAME METHOD URL [-H 'K: V']... [-d BODY | -d @file | -d @-]
                                                  broker makes the call itself

Config: SECRET_BROKER_URL / SECRET_BROKER_KEY, or
~/.config/secret-broker/client.json {"url": ..., "key": ...}.

secret-run help COMMAND    usage and an example for one command
secret-run guide           the manual for agents: workflow, placeholders, approvals, exit codes
"""
import base64
import json
import os
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request


# Exit codes (also in `secret-run guide`).
EXIT_NOT_FOUND, EXIT_USAGE, EXIT_BROKER, EXIT_DENIED, EXIT_EXPIRED = 1, 2, 3, 4, 5
EXIT_HTTP_ERROR = 22

GUIDE = """secret-run guide (for agents)

Use this instead of reading credential files. Real values never reach you: the
broker adds them to the call, and output is masked. Every use asks the human to
approve on their phone (a few secrets are pre-approved; low-risk ones may be too).

Workflow
  1. secret-run which api.example.com      which credential covers this host?
     (or: secret-run list                  all credentials; add --json for scripts)
     prints:  NAME <tab> VAR,VAR   -- the VAR names are the placeholders you can use
  2. secret-run http NAME GET https://api.example.com/v1/things \\
         -H 'Authorization: Bearer {{VAR}}'
     {{VAR}} is replaced by the broker in the URL, headers and body. Use -d BODY,
     -d @file or -d @- (stdin) for a request body.
     The broker only sends the credential to the hosts it is allowed for.
  3. Or run a local command with the value in its environment (output is masked):
     secret-run NAME -- curl -sH "Authorization: Bearer $VAR" https://api.example.com/

Approval
  The command blocks, printing "waiting for approval", for up to about 5 minutes.
  Do not retry or work around a denial or timeout: the human said no or was away.
  Stop and tell them what you needed and why.

Storing and rotating (value ONLY on stdin, never as an argument)
  printf '%s' "$VALUE" | secret-run store NAME --hosts a.example.com[,b] [--field F] [--item I] [--var V]
  printf '%s' "$VALUE" | secret-run update NAME [--var V]
  store creates a credential without a tap; update asks for approval.

Exit codes
  0 ok            1 nothing found (which/list)     2 usage or config error
  3 broker unreachable or refused the request
  4 denied by the human (or the policy)            5 expired or timed out waiting
  22 http: the upstream answered with status >= 400 (body is still printed)
  other: env mode returns the wrapped command's own exit code
"""

HELP = {
    "list": """usage: secret-run list [--json]

List every credential the broker knows: NAME, the VAR placeholders it provides,
and the hosts it may be used against. No approval needed, no values shown.
--json gives [{"name", "vars", "allowed_hosts"}] for scripts.
example: secret-run list --json""",
    "which": """usage: secret-run which HOST|URL

Is a credential available for this host? Prints NAME <tab> VAR,VAR per match.
No approval needed. Exit 1 (and a note on stderr) when nothing matches.
example: secret-run which https://grafana.example.com/api/health""",
    "http": """usage: secret-run http NAME[,NAME] METHOD URL [-H 'K: V']... [-d BODY | -d @file | -d @-]

The broker makes the HTTP call itself and replaces {{VAR}} in the URL, headers and
body with the credential. Waits for the human's approval (up to ~5 min).
Prints "HTTP <status>" on stderr and the response body on stdout; exit 22 if status >= 400.
example: secret-run http grafana GET https://grafana.example.com/api/health \\
             -H 'Authorization: Bearer {{GRAFANA_TOKEN}}'""",
    "run": """usage: secret-run NAME[,NAME] -- command [args...]

Run a command with the credential's variables in its environment. Waits for
approval; stdout/stderr of the command are masked. Exits with the command's code.
example: secret-run grafana -- sh -c 'curl -s -H "Authorization: Bearer $GRAFANA_TOKEN" $URL'""",
    "store": """usage: secret-run store NAME --hosts H[,H] [--field F] [--item I] [--var V]   < value

Create a new credential. The value is read from stdin (or a hidden prompt on a
terminal), never from an argument. --hosts is required: where it may be used.
example: printf '%s' "$TOKEN" | secret-run store myapi --hosts api.example.com""",
    "update": """usage: secret-run update NAME [--var V]   < value

Replace the value of an existing credential (asks for approval). Value on stdin.
example: printf '%s' "$NEW" | secret-run update myapi""",
    "fingerprint": """usage: secret-run fingerprint HOST[:PORT]

Print a server certificate's sha256 (default port 443), for tls_fingerprint in a
credential's metadata. Check it is the device you mean before trusting it.
example: secret-run fingerprint 10.0.0.1:8443""",
    "guide": "usage: secret-run guide\n\nPrint the manual for agents.",
}


def die(msg, code=EXIT_USAGE):
    print(f"secret-run: {msg}", file=sys.stderr)
    sys.exit(code)


def config():
    url, key = os.environ.get("SECRET_BROKER_URL"), os.environ.get("SECRET_BROKER_KEY")
    if not (url and key):
        try:
            with open(os.path.expanduser("~/.config/secret-broker/client.json")) as f:
                c = json.load(f)
            url, key = c["url"], c["key"]
        except (OSError, KeyError, json.JSONDecodeError):
            die("no broker config (set SECRET_BROKER_URL/KEY or ~/.config/secret-broker/client.json)")
    return url.rstrip("/"), key


def call(base, key, path, body=None, timeout=40):
    req = urllib.request.Request(
        base + path, headers={"X-Client-Key": key, "Content-Type": "application/json"},
        data=json.dumps(body).encode() if body is not None else None)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, json.load(r)
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.load(e)
        except json.JSONDecodeError:
            return e.code, {"error": e.reason}
    except OSError as e:
        die(f"cannot reach broker: {e}", EXIT_BROKER)


def status_exit(status):
    return {"denied": EXIT_DENIED, "expired": EXIT_EXPIRED}.get(status, EXIT_BROKER)


def check_name(name, what="NAME"):
    if name.startswith("-"):
        die(f"{what} {name!r} looks like a flag, not a credential name "
            "(see `secret-run list`; `secret-run help` for usage)")
    return name


def obtain(payload):
    base, key = config()
    payload["source"] = f"{os.environ.get('USER', '?')}@{socket.gethostname()}"
    code, r = call(base, key, "/v1/requests", payload)
    if code != 202:
        die(r.get("error", f"broker returned {code}"), EXIT_BROKER)
    if r["status"] in ("denied", "expired", "failed"):
        die(r.get("error") or r["status"], status_exit(r["status"]))
    print("secret-run: waiting for approval on your phone...", file=sys.stderr)
    deadline = time.time() + r["expires_in"] + 15
    while time.time() < deadline:
        code, r2 = call(base, key, f"/v1/requests/{r['id']}?wait=25")
        if r2.get("status") == "approved":
            return r2
        if r2.get("status") in ("denied", "expired", "failed", "released"):
            die(f"request {r2['status']}" + (f": {r2['error']}" if r2.get("error") else ""),
                status_exit(r2["status"]))
    die("timed out waiting for approval", EXIT_EXPIRED)


MAX_BODY = 5_000_000


def read_body(arg):
    """-d BODY | -d @file | -d @- (stdin). Returns payload fields for the broker.

    UTF-8 content is sent as text so {{VAR}} placeholders are substituted;
    anything else is sent as base64 and passed through untouched.
    """
    if not arg.startswith("@"):
        return {"body": arg}
    try:
        raw = sys.stdin.buffer.read() if arg == "@-" else open(arg[1:], "rb").read()
    except OSError as e:
        die(f"cannot read body: {e}")
    if len(raw) > MAX_BODY:
        die(f"body is {len(raw)} bytes; limit is {MAX_BODY}")
    try:
        return {"body": raw.decode("utf-8")}
    except UnicodeDecodeError:
        return {"body_b64": base64.b64encode(raw).decode()}


def read_value():
    """The credential value: stdin (pipe) or a hidden prompt on a terminal. It is
    never accepted as an argument, so it cannot end up in shell history or ps."""
    if sys.stdin.isatty():
        import getpass
        v = getpass.getpass("value (hidden): ")
    else:
        v = sys.stdin.read()
    v = v.rstrip("\r\n")
    if not v:
        die("no value on stdin")
    return v


def parse_flags(argv, allowed):
    out, i = {}, 0
    while i < len(argv):
        k = argv[i]
        if k not in allowed or i + 1 >= len(argv):
            die(f"unexpected argument {k!r}")
        out[allowed[k]] = argv[i + 1]
        i += 2
    return out


def mask(text, values):
    for v in sorted(values, key=len, reverse=True):
        if len(v) >= 6:
            text = text.replace(v, "***")
    return text


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if argv[0] == "guide":
        print(GUIDE)
        return 0
    if argv[0] == "help":
        topic = argv[1] if len(argv) > 1 else None
        if topic is None:
            print(__doc__)
        elif topic in HELP:
            print(HELP[topic])
        else:
            die(f"no help for {topic!r}; commands: {', '.join(k for k in HELP if k != 'run')}")
        return 0
    if argv[0] in HELP and argv[0] != "run":
        # Flags are never credential names or values: --help anywhere before an
        # http body/header value, or anywhere for the commands without free text.
        scan = argv[1:4] if argv[0] == "http" else argv[1:]
        if any(a in ("-h", "--help") for a in scan):
            print(HELP[argv[0]])
            return 0
    if argv[0] in ("store", "update"):
        if len(argv) < 2:
            die(HELP[argv[0]])
        name, op = check_name(argv[1]), "create" if argv[0] == "store" else "update"
        allowed = {"--field": "field", "--item": "item", "--var": "var", "--hosts": "hosts"}
        if op == "update":
            allowed = {"--var": "var"}
        f = parse_flags(argv[2:], allowed)
        payload = {"mode": "store", "names": [name], "op": op, "value": read_value()}
        for k in ("field", "item", "var"):
            if f.get(k):
                payload[k] = f[k]
        if op == "create":
            if not f.get("hosts"):
                die("store needs --hosts (the hosts this credential may be used against)\n" + HELP["store"])
            payload["allowed_hosts"] = [h for h in f["hosts"].split(",") if h]
        r = obtain(payload)["stored"]
        print(f"stored: {r['name']} ({r['op']}) -> item {r['item']!r} field {r['field']}")
        return 0

    if argv[0] == "fingerprint":
        if len(argv) != 2:
            die(HELP["fingerprint"])
        import hashlib
        import socket
        import ssl
        host, _, port = argv[1].partition(":")
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
        try:
            with socket.create_connection((host, int(port or 443)), timeout=10) as raw:
                with ctx.wrap_socket(raw, server_hostname=host) as tls:
                    der = tls.getpeercert(binary_form=True)
        except (OSError, ValueError) as e:
            die(f"could not read a certificate from {argv[1]}: {e}")
        print("sha256:" + hashlib.sha256(der).hexdigest())
        print("secret-run: put this in the item's broker metadata as "
              '"tls_fingerprint" only after checking it is the device you mean.', file=sys.stderr)
        return 0

    if argv[0] == "list":
        if argv[1:] not in ([], ["--json"]):
            die(HELP["list"])
        base, key = config()
        code, r = call(base, key, "/v1/secrets")
        if code != 200:
            die(r.get("error", f"broker returned {code}"), EXIT_BROKER)
        if argv[1:] == ["--json"]:
            print(json.dumps(r["secrets"], indent=2))
            return 0
        if not r["secrets"]:
            print("secret-run: no credentials are configured", file=sys.stderr)
            return EXIT_NOT_FOUND
        print("NAME\tVARS\tHOSTS   (columns; use --json for scripts)", file=sys.stderr)
        for s in r["secrets"]:
            print(f"{s['name']}\t{','.join(s['vars'])}\t{','.join(s['allowed_hosts'])}")
        return 0

    if argv[0] == "which":
        if len(argv) != 2:
            die(HELP["which"])
        check_name(argv[1], "HOST")
        base, key = config()
        target = urllib.parse.quote(argv[1], safe="")
        param = "url" if "://" in argv[1] else "host"
        code, r = call(base, key, f"/v1/secrets?{param}={target}")
        if code != 200:
            die(r.get("error", f"broker returned {code}"), EXIT_BROKER)
        for s in r["secrets"]:
            print(f"{s['name']}\t{','.join(s['vars'])}")
        if not r["secrets"]:
            print(f"secret-run: no credential available for {r['host']}. "
                  "See `secret-run list`, or add one with `secret-run store` "
                  "(`secret-run guide`).", file=sys.stderr)
            return EXIT_NOT_FOUND
        return 0

    if argv[0] == "http":
        if len(argv) < 4:
            die(HELP["http"])
        check_name(argv[1])
        names, method, url, rest = argv[1].split(","), argv[2], argv[3], argv[4:]
        headers, body = {}, {}
        while rest:
            if rest[0] == "-H" and len(rest) > 1:
                k, _, v = rest[1].partition(":")
                headers[k.strip()] = v.strip()
                rest = rest[2:]
            elif rest[0] == "-d" and len(rest) > 1:
                body, rest = read_body(rest[1]), rest[2:]
            else:
                die(f"unexpected argument {rest[0]!r}")
        r = obtain({"mode": "http", "names": names, "method": method, "url": url,
                    "headers": headers, **body})["http"]
        print(f"HTTP {r['status']}", file=sys.stderr)
        sys.stdout.write(r["body"])
        return 0 if r["status"] < 400 else EXIT_HTTP_ERROR

    if "--" not in argv:
        die(f"unknown command {argv[0]!r}.\ncommands: list, which, http, store, update, "
            "fingerprint, help, guide; or: secret-run NAME -- command\n"
            "start with `secret-run guide`")
    i = argv.index("--")
    names, cmd = argv[0].split(",") if i == 1 else None, argv[i + 1:]
    if not names or not cmd:
        die(HELP["run"])
    for n in names:
        check_name(n)
    env = obtain({"mode": "env", "names": names, "argv": cmd})["env"]
    p = subprocess.run(cmd, env={**os.environ, **env}, capture_output=True, text=True)
    sys.stdout.write(mask(p.stdout, env.values()))
    sys.stderr.write(mask(p.stderr, env.values()))
    return p.returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
